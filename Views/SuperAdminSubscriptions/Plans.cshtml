@model IEnumerable<IT15_Project.Models.SubscriptionPlan>

@{
    ViewData["Title"] = "Subscription Plans";
    ViewData["Active"] = "Plans";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- ══════════════════════════════════════
     PAGE HEADER
════════════════════════════════════════ -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Subscription Plans</h1>
        <p>Manage platform subscription plans and pricing tiers</p>
    </div>
    <button class="btn-primary-mx" onclick="openCreatePlanModal()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Create Plan
    </button>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div style="padding:80px 20px;text-align:center;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="64" height="64" style="color:var(--mx-muted);margin:0 auto 20px;">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>
            </svg>
            <h3 style="font-size:18px;font-weight:700;color:var(--mx-txt);margin-bottom:8px;">No Plans Found</h3>
            <p style="color:var(--mx-muted);font-size:14px;margin-bottom:24px;">Create your first subscription plan to get started.</p>
            <button class="btn-primary-mx" onclick="openCreatePlanModal()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Create First Plan
            </button>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:20px;">
        @foreach (var plan in Model)
        {
            var activeCount = plan.CompanySubscriptions?.Count(s => s.IsActive) ?? 0;
            var statusColor = plan.IsActive ? "var(--mx-green)" : "var(--mx-muted)";
            var statusBg = plan.IsActive ? "rgba(34,197,94,.10)" : "rgba(148,163,184,.10)";
            
            <div class="card" style="padding:0;overflow:hidden;border:2px solid @(plan.IsActive ? "var(--mx-border)" : "var(--mx-muted)");">
                <!-- Header -->
                <div style="padding:20px;background:var(--mx-surface);border-bottom:1px solid var(--mx-border);">
                    <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:12px;">
                        <div>
                            <h3 style="font-size:20px;font-weight:800;color:var(--mx-txt);margin-bottom:4px;">@plan.Name</h3>
                            <span class="badge" style="background:@statusBg;color:@statusColor;padding:5px 11px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">
                                @(plan.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <div class="action-menu">
                            <button class="action-trigger" style="padding:6px 10px;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                    <circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>
                                </svg>
                            </button>
                            <div class="action-dropdown">
                                <a href="#" onclick="editPlan(@plan.PlanId); return false;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                    Edit Plan
                                </a>
                                <a href="#" onclick="togglePlanStatus(@plan.PlanId); return false;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                                    </svg>
                                    @(plan.IsActive ? "Deactivate" : "Activate")
                                </a>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(plan.Description))
                    {
                        <p style="font-size:13px;color:var(--mx-muted);line-height:1.5;">@plan.Description</p>
                    }
                </div>
                
                <!-- Pricing -->
                <div style="padding:24px 20px;background:var(--mx-white);">
                    @if (plan.Name == "Starter" && plan.MonthlyPrice == 0)
                    {
                        <!-- Free Trial Badge -->
                        <div style="text-align:center;margin-bottom:20px;">
                            <div style="display:inline-block;background:linear-gradient(135deg,var(--mx-blue),var(--mx-navy));color:white;padding:12px 24px;border-radius:8px;margin-bottom:12px;">
                                <div style="font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">14-Day Free Trial</div>
                                <div style="font-size:32px;font-weight:900;letter-spacing:-1px;">FREE</div>
                            </div>
                            <div style="font-size:12px;color:var(--mx-muted);font-weight:500;">No credit card required</div>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex;gap:20px;margin-bottom:20px;">
                            <div style="flex:1;">
                                <div style="font-size:11px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;margin-bottom:6px;">Monthly</div>
                                <div style="font-size:28px;font-weight:800;color:var(--mx-navy);">
                                    $@plan.MonthlyPrice.ToString("N2")
                                    <span style="font-size:14px;font-weight:500;color:var(--mx-muted);">/mo</span>
                                </div>
                            </div>
                            <div style="flex:1;">
                                <div style="font-size:11px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;margin-bottom:6px;">Yearly</div>
                                <div style="font-size:28px;font-weight:800;color:var(--mx-navy);">
                                    $@plan.YearlyPrice.ToString("N2")
                                    <span style="font-size:14px;font-weight:500;color:var(--mx-muted);">/yr</span>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <!-- Limits -->
                    <div style="display:grid;gap:10px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--mx-surface);border-radius:6px;">
                            <span style="font-size:12px;color:var(--mx-muted);font-weight:600;">Max Users</span>
                            <span style="font-size:14px;font-weight:700;color:var(--mx-txt);">@(plan.MaxUsers?.ToString() ?? "Unlimited")</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--mx-surface);border-radius:6px;">
                            <span style="font-size:12px;color:var(--mx-muted);font-weight:600;">Max Assets</span>
                            <span style="font-size:14px;font-weight:700;color:var(--mx-txt);">@(plan.MaxAssets?.ToString() ?? "Unlimited")</span>
                        </div>
                        @if (plan.MaxWorkOrdersPerMonth.HasValue)
                        {
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:var(--mx-surface);border-radius:6px;">
                                <span style="font-size:12px;color:var(--mx-muted);font-weight:600;">Max WOs/Month</span>
                                <span style="font-size:14px;font-weight:700;color:var(--mx-txt);">@plan.MaxWorkOrdersPerMonth</span>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Footer -->
                <div style="padding:16px 20px;background:var(--mx-surface);border-top:1px solid var(--mx-border);">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <div>
                            <div style="font-size:11px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;margin-bottom:2px;">Active Tenants</div>
                            <div style="font-size:20px;font-weight:800;color:var(--mx-navy);">@activeCount</div>
                        </div>
                        <button class="btn-secondary-mx" onclick="viewPlanDetails(@plan.PlanId)">View Details</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ══════════════════════════════════════
     MODAL: CREATE PLAN
════════════════════════════════════════ -->
<div id="createPlanModal" class="mx-modal-overlay">
    <div class="mx-modal" style="max-width:720px;">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-title">Create Subscription Plan</div>
                    <div class="modal-subtitle">Define a new subscription tier</div>
                </div>
            </div>
            <button class="modal-close" onclick="closeCreatePlanModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="createPlanForm">
                <div class="modal-section-label">Plan Details</div>
                
                <div class="modal-full">
                    <label class="mx-label">Plan Name <span class="required">*</span></label>
                    <input type="text" id="planName" class="mx-input" placeholder="e.g., Professional" required />
                </div>
                
                <div class="modal-full">
                    <label class="mx-label">Description</label>
                    <textarea id="planDescription" class="mx-textarea" rows="3" placeholder="Brief description of the plan"></textarea>
                    <div class="input-hint">Describe what this plan offers to customers</div>
                </div>
                
                <div class="modal-section-label" style="margin-top:24px;">Pricing</div>
                
                <div class="modal-grid-2">
                    <div>
                        <label class="mx-label">Monthly Price <span class="required">*</span></label>
                        <input type="number" id="monthlyPrice" class="mx-input" step="0.01" min="0" placeholder="0.00" required />
                        <div class="input-hint">Price per month in USD</div>
                    </div>
                    <div>
                        <label class="mx-label">Yearly Price <span class="required">*</span></label>
                        <input type="number" id="yearlyPrice" class="mx-input" step="0.01" min="0" placeholder="0.00" required />
                        <div class="input-hint">Price per year in USD</div>
                    </div>
                </div>
                
                <div class="modal-section-label" style="margin-top:24px;">Resource Limits</div>
                
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px;">
                    <div>
                        <label class="mx-label">Max Users</label>
                        <input type="number" id="maxUsers" class="mx-input" min="1" placeholder="Unlimited" />
                    </div>
                    <div>
                        <label class="mx-label">Max Assets</label>
                        <input type="number" id="maxAssets" class="mx-input" min="1" placeholder="Unlimited" />
                    </div>
                    <div>
                        <label class="mx-label">Max WOs/Month</label>
                        <input type="number" id="maxWorkOrders" class="mx-input" min="1" placeholder="Unlimited" />
                    </div>
                </div>
                <div class="input-hint" style="margin-top:-8px;margin-bottom:16px;">Leave blank for unlimited access</div>
                
                <div class="modal-section-label" style="margin-top:24px;">Advanced</div>
                
                <div class="modal-full" style="margin-bottom:0;">
                    <label class="mx-label">Features (JSON)</label>
                    <textarea id="featuresJson" class="mx-textarea" rows="4" placeholder='{"feature1": true, "feature2": false}' style="font-family:monospace;font-size:12.5px;"></textarea>
                    <div class="input-hint">Optional JSON object for feature flags and custom attributes</div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeCreatePlanModal()">Cancel</button>
            <button class="btn-modal-submit" onclick="createPlan()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                Create Plan
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openCreatePlanModal() {
    document.getElementById('createPlanModal').classList.add('open');
}

function closeCreatePlanModal() {
    document.getElementById('createPlanModal').classList.remove('open');
    document.getElementById('createPlanForm').reset();
}

async function createPlan() {
    const data = {
        name: document.getElementById('planName').value,
        description: document.getElementById('planDescription').value || null,
        monthlyPrice: parseFloat(document.getElementById('monthlyPrice').value),
        yearlyPrice: parseFloat(document.getElementById('yearlyPrice').value),
        maxUsers: document.getElementById('maxUsers').value ? parseInt(document.getElementById('maxUsers').value) : null,
        maxAssets: document.getElementById('maxAssets').value ? parseInt(document.getElementById('maxAssets').value) : null,
        maxWorkOrdersPerMonth: document.getElementById('maxWorkOrders').value ? parseInt(document.getElementById('maxWorkOrders').value) : null,
        featuresJson: document.getElementById('featuresJson').value || null
    };

    try {
        const response = await fetch('/superadmin/subscriptions/plans/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
            alert('Plan created successfully!');
            location.reload();
        } else {
            alert('Failed to create plan: ' + result.message);
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred while creating the plan.');
    }
}

async function togglePlanStatus(planId) {
    if (!confirm('Are you sure you want to toggle this plan status?')) return;

    try {
        const response = await fetch(`/superadmin/subscriptions/plans/${planId}/toggle`, {
            method: 'POST'
        });

        const result = await response.json();
        if (result.success) {
            location.reload();
        } else {
            alert('Failed to toggle plan status.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('An error occurred.');
    }
}

function editPlan(planId) {
    alert('Edit functionality coming soon!');
}

function viewPlanDetails(planId) {
    alert('View details functionality coming soon!');
}
</script>
}
