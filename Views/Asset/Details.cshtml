@model IT15_Project.Models.Asset
@{
    ViewData["Title"] = "Asset Details";
    ViewData["Active"] = "Assets";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var workOrders = ViewBag.WorkOrders as List<IT15_Project.Models.WorkOrder>;
    var maintenanceLogs = ViewBag.MaintenanceLogs as List<IT15_Project.Models.MaintenanceLog>;
    var preventiveSchedules = ViewBag.PreventiveSchedules as List<IT15_Project.Models.PreventiveSchedule>;
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-left">
        <h1>@Model.AssetName</h1>
        <p>Asset details and maintenance history</p>
    </div>
    <a href="/admin/assets" class="btn-secondary-mx">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Assets
    </a>
</div>

<!-- ASSET INFO CARD -->
<div class="card" style="margin-bottom:20px;">
    <div class="section-header">
        <h2>Asset Information</h2>
        <span class="badge badge-@(Model.Status == "Active" ? "done" : "cancelled")">@Model.Status</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:20px;">
        <div>
            <label class="mx-label">Asset Name</label>
            <div class="mx-readonly">@Model.AssetName</div>
        </div>
        <div>
            <label class="mx-label">Asset Code</label>
            <div class="mx-readonly">@(Model.AssetCode ?? "—")</div>
        </div>
        <div>
            <label class="mx-label">Category</label>
            <div class="mx-readonly">@(Model.Category?.CategoryName ?? "Uncategorized")</div>
        </div>
        <div>
            <label class="mx-label">Location</label>
            <div class="mx-readonly">@(Model.Location ?? "—")</div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div style="margin-top:20px;">
            <label class="mx-label">Description</label>
            <div class="mx-readonly">@Model.Description</div>
        </div>
    }
</div>

<!-- MAINTENANCE HISTORY TABS -->
<div class="card">
    <div class="section-header">
        <h2>Maintenance History</h2>
    </div>
    
    <div style="border-bottom:1px solid var(--mx-border);margin:20px 0;">
        <div style="display:flex;gap:10px;">
            <button class="history-tab active" data-tab="work-orders">
                Work Orders (@(workOrders?.Count ?? 0))
            </button>
            <button class="history-tab" data-tab="maintenance-logs">
                Maintenance Logs (@(maintenanceLogs?.Count ?? 0))
            </button>
            <button class="history-tab" data-tab="preventive">
                Preventive Schedules (@(preventiveSchedules?.Count ?? 0))
            </button>
        </div>
    </div>

    <!-- WORK ORDERS TAB -->
    <div class="history-content active" id="work-orders-content">
        @if (workOrders != null && workOrders.Any())
        {
            <table class="mx-table">
                <thead>
                    <tr>
                        <th>WO ID</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Assigned To</th>
                        <th>Created</th>
                        <th>Due Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wo in workOrders)
                    {
                        <tr>
                            <td class="td-id">WO-@wo.WorkOrderId</td>
                            <td><span class="badge badge-@(wo.Status?.ToLower().Replace(" ", "-"))">@wo.Status</span></td>
                            <td><span class="badge badge-priority-@(wo.Priority?.ToLower())">@wo.Priority</span></td>
                            <td>
                                @if (wo.AssignedToPersonnel != null)
                                {
                                    <div class="td-staff">
                                        <div class="td-avatar">@($"{wo.AssignedToPersonnel.FirstName?.FirstOrDefault()}{wo.AssignedToPersonnel.LastName?.FirstOrDefault()}")</div>
                                        @wo.AssignedToPersonnel.FullName
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);">Unassigned</span>
                                }
                            </td>
                            <td style="font-size:12.5px;color:var(--mx-muted)">@(wo.DateCreated.HasValue ? wo.DateCreated.Value.ToString("MMM dd, yyyy") : "—")</td>
                            <td style="font-size:12.5px;color:var(--mx-muted)">@(wo.DueDate.HasValue ? wo.DueDate.Value.ToString("MMM dd, yyyy") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="text-align:center;padding:40px;color:var(--mx-muted);">
                No work orders found for this asset.
            </div>
        }
    </div>

    <!-- MAINTENANCE LOGS TAB -->
    <div class="history-content" id="maintenance-logs-content">
        @if (maintenanceLogs != null && maintenanceLogs.Any())
        {
            <table class="mx-table">
                <thead>
                    <tr>
                        <th>Log ID</th>
                        <th>Title</th>
                        <th>Completed By</th>
                        <th>Completed Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in maintenanceLogs)
                    {
                        <tr>
                            <td class="td-id">#@log.LogId</td>
                            <td>@log.Title</td>
                            <td>
                                @if (log.CompletedByPersonnel != null)
                                {
                                    <div class="td-staff">
                                        <div class="td-avatar">@($"{log.CompletedByPersonnel.FirstName?.FirstOrDefault()}{log.CompletedByPersonnel.LastName?.FirstOrDefault()}")</div>
                                        @log.CompletedByPersonnel.FullName
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);">Unknown</span>
                                }
                            </td>
                            <td style="font-size:12.5px;color:var(--mx-muted)">@log.CompletedDate.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="text-align:center;padding:40px;color:var(--mx-muted);">
                No maintenance logs found for this asset.
            </div>
        }
    </div>

    <!-- PREVENTIVE SCHEDULES TAB -->
    <div class="history-content" id="preventive-content">
        @if (preventiveSchedules != null && preventiveSchedules.Any())
        {
            <table class="mx-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Frequency</th>
                        <th>Next Due</th>
                        <th>Default Technician</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var schedule in preventiveSchedules)
                    {
                        <tr>
                            <td>@schedule.Title</td>
                            <td style="font-size:13px;color:var(--mx-muted)">Every @schedule.FrequencyDays days</td>
                            <td style="font-size:12.5px;color:var(--mx-muted)">@schedule.NextDueDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (schedule.DefaultTechnician != null)
                                {
                                    <div class="td-staff">
                                        <div class="td-avatar">@($"{schedule.DefaultTechnician.FirstName?.FirstOrDefault()}{schedule.DefaultTechnician.LastName?.FirstOrDefault()}")</div>
                                        @schedule.DefaultTechnician.FullName
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);">Unassigned</span>
                                }
                            </td>
                            <td><span class="badge badge-done">Active</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="text-align:center;padding:40px;color:var(--mx-muted);">
                No preventive schedules found for this asset.
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.history-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.history-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.history-content').forEach(c => c.classList.remove('active'));
            
            this.classList.add('active');
            document.getElementById(this.dataset.tab + '-content').classList.add('active');
        });
    });
</script>
}
