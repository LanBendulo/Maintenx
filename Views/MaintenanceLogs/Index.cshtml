@model List<IT15_Project.Models.MaintenanceLog>
@{
    ViewData["Title"] = "Maintenance Logs";
    ViewData["Active"] = "MaintenanceLogs";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Maintenance Logs</h1>
        <p>Historical records of completed work orders</p>
    </div>
</div>

<!-- SUMMARY CARDS -->
<div class="wo-stats">
    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <span class="stat-trend up">↑ @(Model?.Count ?? 0)</span>
        </div>
        <div class="stat-value">@(Model?.Count ?? 0)</div>
        <div class="stat-label">Total Logs</div>
    </div>
    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <span class="stat-trend up">↑ @(Model?.Count(l => l.CompletedDate.Month == DateTime.Now.Month) ?? 0)</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@(Model?.Count(l => l.CompletedDate.Month == DateTime.Now.Month) ?? 0)</div>
        <div class="stat-label">This Month</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <span class="stat-trend">● @(Model?.Count(l => l.CompletedDate >= DateTime.Today.AddDays(-7)) ?? 0)</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@(Model?.Count(l => l.CompletedDate >= DateTime.Today.AddDays(-7)) ?? 0)</div>
        <div class="stat-label">This Week</div>
    </div>
</div>

<!-- FILTER BAR -->
<div class="card" style="margin-bottom:20px;padding:18px 22px;">
    <div class="filter-bar" style="margin-bottom:0;">
        <div class="filter-search" style="max-width:400px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="log-search" placeholder="Search WO ID, asset, title…" value="@ViewBag.Search" />
        </div>
        <button class="filter-reset" id="reset-filters">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
            Reset
        </button>
    </div>
</div>

<!-- LOGS TABLE -->
<div class="card">
    <div class="section-header" style="margin-bottom:8px;">
        <h2>Maintenance History</h2>
        <span id="row-count" class="table-meta">Showing <strong>@(Model?.Count ?? 0)</strong> results</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="mx-table" id="logs-table">
            <thead>
                <tr>
                    <th>Log ID</th>
                    <th>WO ID</th>
                    <th>Asset</th>
                    <th>Title</th>
                    <th>Completed By</th>
                    <th>Completed Date</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="logs-tbody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="td-id">#@log.LogId</td>
                            <td class="td-id">WO-@log.WorkOrderId</td>
                            <td class="td-equip">@(log.Asset?.AssetName ?? "N/A")</td>
                            <td>@log.Title</td>
                            <td>
                                @if (log.CompletedByPersonnel != null)
                                {
                                    <div class="td-staff">
                                        <div class="td-avatar">@($"{log.CompletedByPersonnel.FirstName?.FirstOrDefault()}{log.CompletedByPersonnel.LastName?.FirstOrDefault()}")</div>
                                        @log.CompletedByPersonnel.FullName
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);font-size:13px;">Unassigned</span>
                                }
                            </td>
                            <td style="font-size:12.5px;color:var(--mx-muted)">@log.CompletedDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="text-align:right;">
                                <button class="btn-view-details" data-log-id="@log.LogId">View Details</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:40px;color:var(--mx-muted);">
                            No maintenance logs found. Logs are created automatically when work orders are completed.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DETAILS MODAL -->
<div class="mx-modal-overlay" id="detailsModal" role="dialog" aria-modal="true">
    <div class="mx-modal">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div>
                    <div class="modal-title">Maintenance Log Details</div>
                    <div class="modal-subtitle">Read-only historical record</div>
                </div>
            </div>
            <button class="modal-close" id="closeDetailsModal">×</button>
        </div>

        <div class="modal-body">
            <div class="modal-section-label">Work Order Information</div>
            <div class="modal-grid-2">
                <div>
                    <label class="mx-label">Log ID</label>
                    <div class="mx-readonly" id="detail-log-id"></div>
                </div>
                <div>
                    <label class="mx-label">Work Order ID</label>
                    <div class="mx-readonly" id="detail-wo-id"></div>
                </div>
            </div>
            <div class="modal-full">
                <label class="mx-label">Asset</label>
                <div class="mx-readonly" id="detail-asset"></div>
            </div>
            <div class="modal-full">
                <label class="mx-label">Title</label>
                <div class="mx-readonly" id="detail-title"></div>
            </div>
            <div class="modal-full">
                <label class="mx-label">Description</label>
                <div class="mx-readonly" id="detail-description"></div>
            </div>

            <div class="modal-section-label">Completion Information</div>
            <div class="modal-grid-2">
                <div>
                    <label class="mx-label">Completed By</label>
                    <div class="mx-readonly" id="detail-completed-by"></div>
                </div>
                <div>
                    <label class="mx-label">Completed Date</label>
                    <div class="mx-readonly" id="detail-completed-date"></div>
                </div>
            </div>
            <div class="modal-full">
                <label class="mx-label">Notes</label>
                <div class="mx-readonly" id="detail-notes"></div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancel" id="cancelDetailsModal">Close</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/maintenance-logs.js" asp-append-version="true"></script>
}
