@model IEnumerable<IT15_Project.Models.InventoryMovement>

@{
    ViewData["Title"] = "Inventory Movements";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
    ViewData["Active"] = "InventoryMovements";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Inventory Movements</h1>
        <p>Complete audit trail of all inventory stock changes</p>
    </div>
</div>

<!-- SUMMARY CARDS -->
<div class="wo-stats" style="grid-template-columns: repeat(4, 1fr);">
    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @ViewBag.TotalMovements</span>
        </div>
        <div class="stat-value">@ViewBag.TotalMovements</div>
        <div class="stat-label">Total Movements</div>
    </div>

    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                </svg>
            </div>
            <span class="stat-trend warn">● @ViewBag.ConsumptionCount</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@ViewBag.ConsumptionCount</div>
        <div class="stat-label">Consumption</div>
    </div>

    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @ViewBag.RestockCount</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@ViewBag.RestockCount</div>
        <div class="stat-label">Restocks</div>
    </div>

    <div class="stat-card navy">
        <div class="stat-top">
            <div class="stat-icon navy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
            </div>
            <span class="stat-trend">● @ViewBag.AdjustmentCount</span>
        </div>
        <div class="stat-value" style="color:var(--mx-navy)">@ViewBag.AdjustmentCount</div>
        <div class="stat-label">Adjustments</div>
    </div>
</div>

<!-- FILTER BAR -->
<div class="card" style="margin-bottom:20px;padding:18px 22px;">
    <form method="get" action="/supervisor/inventory-movements" class="filter-bar" style="margin-bottom:0;">
        <div class="filter-search" style="max-width:300px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" name="search" id="movement-search" placeholder="Search part name, SKU, notes..." value="@ViewBag.SearchFilter" />
        </div>

        <select class="filter-select" name="movementType" id="filter-movement-type">
            <option value="">All Movement Types</option>
            <option value="Consumption" selected="@(ViewBag.MovementTypeFilter == "Consumption" ? "selected" : null)">Consumption</option>
            <option value="Restock" selected="@(ViewBag.MovementTypeFilter == "Restock" ? "selected" : null)">Restock</option>
            <option value="Adjustment" selected="@(ViewBag.MovementTypeFilter == "Adjustment" ? "selected" : null)">Adjustment</option>
            <option value="Correction" selected="@(ViewBag.MovementTypeFilter == "Correction" ? "selected" : null)">Correction</option>
            <option value="InitialStock" selected="@(ViewBag.MovementTypeFilter == "InitialStock" ? "selected" : null)">Initial Stock</option>
            <option value="Return" selected="@(ViewBag.MovementTypeFilter == "Return" ? "selected" : null)">Return</option>
            <option value="Transfer" selected="@(ViewBag.MovementTypeFilter == "Transfer" ? "selected" : null)">Transfer</option>
        </select>

        <select class="filter-select" name="partFilter" id="filter-part">
            <option value="">All Parts</option>
            @if (ViewBag.Parts != null)
            {
                @foreach (var part in ViewBag.Parts)
                {
                    var selected = ViewBag.PartFilter == part.PartId.ToString() ? "selected" : "";
                    var label = part.PartNumber != null ? $"{part.PartName} ({part.PartNumber})" : part.PartName;
                    <option value="@part.PartId" selected="@selected">@label</option>
                }
            }
        </select>

        <input type="date" name="startDate" class="filter-select" placeholder="Start Date" value="@ViewBag.StartDateFilter" style="max-width:160px;" />
        <input type="date" name="endDate" class="filter-select" placeholder="End Date" value="@ViewBag.EndDateFilter" style="max-width:160px;" />

        <button type="submit" class="btn-primary-mx" style="padding:9px 18px;font-size:13px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            Filter
        </button>

        <a href="/supervisor/inventory-movements" class="filter-reset" style="padding:9px 14px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/>
            </svg>
            Reset
        </a>
    </form>
</div>

<!-- MOVEMENTS TABLE -->
<div class="card">
    <div class="section-header" style="margin-bottom:8px;">
        <h2>Movement History</h2>
        <span id="row-count" class="table-meta">Showing <strong>@(Model?.Count() ?? 0)</strong> movements</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="mx-table" id="movements-table">
            <thead>
                <tr>
                    <th>Date/Time</th>
                    <th>Part Name</th>
                    <th>SKU</th>
                    <th>Movement Type</th>
                    <th style="text-align:right;">Qty Changed</th>
                    <th style="text-align:right;">Previous</th>
                    <th style="text-align:right;">New</th>
                    <th>Work Order</th>
                    <th>Performed By</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody id="movements-tbody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var movement in Model)
                    {
                        var movementTypeClass = movement.MovementType?.ToLower() switch
                        {
                            "consumption" => "consumption",
                            "restock" => "restock",
                            "adjustment" => "adjustment",
                            "correction" => "correction",
                            "initialstock" => "initialstock",
                            "return" => "return",
                            "transfer" => "transfer",
                            _ => "default"
                        };

                        var quantityClass = movement.QuantityChanged < 0 ? "negative" : "positive";

                        <tr data-movement-type="@movementTypeClass">
                            <td style="font-size:12.5px;color:var(--mx-text);white-space:nowrap;">
                                @movement.CreatedAt.ToString("MMM dd, yyyy")
                                <div style="font-size:11px;color:var(--mx-muted);margin-top:2px;">
                                    @movement.CreatedAt.ToString("hh:mm tt")
                                </div>
                            </td>
                            <td>
                                <div style="font-weight:500;color:var(--mx-text);">
                                    @(movement.Part?.PartName ?? "Unknown")
                                </div>
                            </td>
                            <td style="font-size:12px;color:var(--mx-muted);">
                                @(movement.Part?.PartNumber ?? "-")
                            </td>
                            <td>
                                <span class="movement-badge movement-@movementTypeClass">
                                    @movement.MovementType
                                </span>
                            </td>
                            <td style="text-align:right;font-weight:600;font-size:14px;" class="qty-@quantityClass">
                                @(movement.QuantityChanged > 0 ? "+" : "")@movement.QuantityChanged
                            </td>
                            <td style="text-align:right;font-size:13px;color:var(--mx-muted);">
                                @movement.PreviousQuantity
                            </td>
                            <td style="text-align:right;font-size:13px;font-weight:500;">
                                @movement.NewQuantity
                            </td>
                            <td>
                                @if (movement.WorkOrderId.HasValue)
                                {
                                    <span style="color:var(--mx-primary);font-weight:500;">
                                        #WO-@movement.WorkOrderId.Value.ToString("D4")
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);">-</span>
                                }
                            </td>
                            <td style="font-size:12px;color:var(--mx-muted);">
                                @(movement.PerformedByUser?.Email ?? "System")
                            </td>
                            <td style="font-size:12px;color:var(--mx-muted);max-width:200px;">
                                <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@movement.Notes">
                                    @(movement.Notes ?? "-")
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" style="text-align:center;padding:40px;color:var(--mx-muted);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:48px;height:48px;margin:0 auto 16px;opacity:0.3;">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                            <p>No inventory movements found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
/* Movement Type Badges */
.movement-badge {
    display: inline-block;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    border-radius: 5px;
    text-transform: capitalize;
}

.movement-consumption {
    background: rgba(239, 68, 68, 0.12);
    color: #DC2626;
}

.movement-restock {
    background: rgba(34, 197, 94, 0.12);
    color: #16A34A;
}

.movement-adjustment,
.movement-correction {
    background: rgba(59, 130, 246, 0.12);
    color: #2563EB;
}

.movement-initialstock {
    background: rgba(168, 85, 247, 0.12);
    color: #9333EA;
}

.movement-return {
    background: rgba(251, 146, 60, 0.12);
    color: #EA580C;
}

.movement-transfer {
    background: rgba(20, 184, 166, 0.12);
    color: #0D9488;
}

.movement-default {
    background: rgba(148, 163, 184, 0.12);
    color: #64748B;
}

/* Quantity Change Styling */
.qty-negative {
    color: #DC2626;
}

.qty-positive {
    color: #16A34A;
}

/* Compact table styling */
.mx-table td {
    padding: 12px 14px;
}

.mx-table th {
    padding: 10px 14px;
}
</style>
