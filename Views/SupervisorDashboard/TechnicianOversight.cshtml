@using System.Linq
@model dynamic

@{
    ViewData["Title"] = "Technician Oversight";
    ViewData["Active"] = "TechnicianOversight";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
    
    int totalTechnicians = 0;
    int totalActiveWOs = 0;
    int totalCompleted = 0;
    
    foreach (var tech in Model)
    {
        totalTechnicians++;
        totalActiveWOs += tech.ActiveWorkOrders;
        totalCompleted += tech.CompletedThisMonth;
    }
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

@if (totalTechnicians == 0)
{
    <div class="card" style="text-align:center;padding:60px 20px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="64" height="64" style="color:var(--mx-muted);margin-bottom:16px;">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <h3 style="font-size:18px;font-weight:700;color:var(--mx-txt);margin-bottom:8px;">No Technicians Found</h3>
        <p style="color:var(--mx-muted);font-size:14px;">No active technicians are currently in the system.</p>
    </div>
}
else
{
    <!-- SUMMARY CARDS -->
    <div class="stats-grid">
        <div class="stat-card navy">
            <div class="stat-top">
                <div class="stat-icon navy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <span class="stat-trend up">↑ @totalTechnicians</span>
            </div>
            <div class="stat-value" style="color:var(--mx-navy)">@totalTechnicians</div>
            <div class="stat-label">Active Technicians</div>
        </div>

        <div class="stat-card blue">
            <div class="stat-top">
                <div class="stat-icon blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                    </svg>
                </div>
                <span class="stat-trend up">↑ @totalActiveWOs</span>
            </div>
            <div class="stat-value">@totalActiveWOs</div>
            <div class="stat-label">Total Active Work Orders</div>
        </div>

        <div class="stat-card green">
            <div class="stat-top">
                <div class="stat-icon green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                </div>
                <span class="stat-trend up">↑ @totalCompleted</span>
            </div>
            <div class="stat-value" style="color:var(--mx-green)">@totalCompleted</div>
            <div class="stat-label">Completed This Month</div>
        </div>
    </div>

    <!-- TECHNICIAN CARDS -->
    <div class="card">
        <div class="section-header" style="margin-bottom:16px;">
            <h2>Technician Workload</h2>
            <span class="table-meta">Monitor technician assignments and performance</span>
        </div>
        
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;">
            @foreach (var tech in Model)
            {
                var activeWOs = tech.ActiveWorkOrders;
                var completedWOs = tech.CompletedThisMonth;
                var workloadColor = activeWOs > 5 ? "var(--mx-red)" : activeWOs > 2 ? "var(--mx-orange)" : "var(--mx-green)";
                var workloadBg = activeWOs > 5 ? "rgba(239,68,68,.10)" : activeWOs > 2 ? "rgba(244,121,32,.10)" : "rgba(34,197,94,.10)";
                var initials = tech.Personnel.FirstName.Substring(0, 1) + tech.Personnel.LastName.Substring(0, 1);
                
                <div style="background:var(--mx-surface);border-radius:10px;padding:18px;border-left:3px solid @workloadColor;">
                    <!-- Header -->
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                        <div class="td-avatar" style="width:44px;height:44px;font-size:16px;">@initials</div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:15px;font-weight:700;color:var(--mx-txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @tech.Personnel.FirstName @tech.Personnel.LastName
                            </div>
                            <div style="font-size:12px;color:var(--mx-muted);">@tech.Personnel.Role</div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:22px;font-weight:800;color:@workloadColor;line-height:1;">@activeWOs</div>
                            <div style="font-size:10px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;">Active</div>
                        </div>
                    </div>
                    
                    <!-- Skills -->
                    @if (!string.IsNullOrEmpty(tech.Personnel.SkillSet))
                    {
                        <div style="margin-bottom:12px;">
                            <div style="font-size:10.5px;font-weight:700;color:var(--mx-muted);text-transform:uppercase;letter-spacing:0.6px;margin-bottom:6px;">Skills</div>
                            <div style="display:flex;flex-wrap:wrap;gap:4px;">
                                @{
                                    string skillSetString = tech.Personnel.SkillSet ?? "";
                                    string[] skillsArray = skillSetString.Split(',');
                                    var displaySkills = skillsArray.Take(4).ToList();
                                }
                                @foreach (var skill in displaySkills)
                                {
                                    <span style="display:inline-block;padding:3px 8px;background:var(--mx-white);color:var(--mx-txt);border-radius:4px;font-size:11px;font-weight:500;border:1px solid var(--mx-border);">
                                        @skill.Trim()
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    
                    <!-- Stats Grid -->
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;padding-top:12px;border-top:1px solid var(--mx-border);">
                        <div>
                            <div style="font-size:10px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;margin-bottom:3px;">Active WOs</div>
                            <div style="font-size:18px;font-weight:800;color:var(--mx-txt);">@activeWOs</div>
                        </div>
                        <div>
                            <div style="font-size:10px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;margin-bottom:3px;">Completed</div>
                            <div style="font-size:18px;font-weight:800;color:var(--mx-green);">@completedWOs</div>
                        </div>
                    </div>
                    
                    <!-- Workload Bar -->
                    <div style="margin-top:12px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <span style="font-size:10px;color:var(--mx-muted);text-transform:uppercase;font-weight:600;letter-spacing:0.5px;">Workload</span>
                            <span style="font-size:11px;font-weight:700;color:@workloadColor;">
                                @(activeWOs > 5 ? "High" : activeWOs > 2 ? "Moderate" : "Light")
                            </span>
                        </div>
                        <div style="height:6px;background:var(--mx-border);border-radius:3px;overflow:hidden;">
                            @{
                                var workloadPercent = Math.Min((activeWOs * 20), 100);
                            }
                            <div style="width:@(workloadPercent)%;height:100%;background:@workloadColor;transition:width 0.3s;"></div>
                        </div>
                    </div>
                    
                    <!-- Hourly Rate -->
                    @{
                        decimal hourlyRate = tech.Personnel.HourlyRate ?? 0m;
                    }
                    @if (hourlyRate > 0)
                    {
                        <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--mx-border);">
                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                <span style="font-size:11px;color:var(--mx-muted);font-weight:600;">Hourly Rate:</span>
                                <span style="font-size:13px;font-weight:700;color:var(--mx-txt);">$@hourlyRate.ToString("F2")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
