@model IT15_Project.Models.ViewModels.PersonnelCreateEditViewModel
@{
    ViewData["Title"] = "Edit Personnel";
    ViewData["Active"] = "Personnel";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- ══════════════════════════════════════
     PAGE HEADER WITH BREADCRUMB
════════════════════════════════════════ -->
<div class="personnel-details-header">
    <div class="header-top-row">
        <button class="btn-back-compact" onclick="window.location.href='/admin/personnel/@Model.PersonnelId'">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back
        </button>
        <div class="breadcrumb-compact">
            <a href="/admin/personnel">Personnel</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            <a href="/admin/personnel/@Model.PersonnelId">@Model.FirstName @Model.LastName</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            <span>Edit</span>
        </div>
    </div>
    <div class="header-main-row">
        <div class="header-title-group">
            <h1>Edit Personnel</h1>
        </div>
    </div>
    <div class="header-meta">
        <span class="meta-item">Update personnel information and employment details</span>
    </div>
</div>

<!-- ══════════════════════════════════════
     FORM CONTAINER
════════════════════════════════════════ -->
<form asp-action="Edit" asp-route-id="@Model.PersonnelId" method="post" class="personnel-form-container">
    @Html.AntiForgeryToken()
    
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="margin-bottom:20px;"></div>

    <!-- BASIC INFORMATION SECTION -->
    <div class="form-section-card">
        <div class="card-header-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            <h2>Basic Information</h2>
        </div>

        <div class="form-section-body">
            <div class="form-grid">
                <div class="form-grid-full">
                    <label asp-for="EmployeeId" class="mx-label">Employee ID <span class="required">*</span></label>
                    <input asp-for="EmployeeId" class="mx-input" placeholder="e.g., EMP-001" required />
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                    <span class="input-hint">Unique identifier for this employee</span>
                </div>

                <div>
                    <label asp-for="FirstName" class="mx-label">First Name <span class="required">*</span></label>
                    <input asp-for="FirstName" class="mx-input" placeholder="Enter first name" required />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="MiddleName" class="mx-label">Middle Name</label>
                    <input asp-for="MiddleName" class="mx-input" placeholder="Enter middle name (optional)" />
                    <span asp-validation-for="MiddleName" class="text-danger"></span>
                </div>

                <div class="form-grid-full">
                    <label asp-for="LastName" class="mx-label">Last Name <span class="required">*</span></label>
                    <input asp-for="LastName" class="mx-input" placeholder="Enter last name" required />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTACT INFORMATION SECTION -->
    <div class="form-section-card">
        <div class="card-header-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <h2>Contact Information</h2>
        </div>

        <div class="form-section-body">
            <div class="form-grid">
                <div>
                    <label asp-for="Email" class="mx-label">Email Address</label>
                    <input asp-for="Email" type="email" class="mx-input" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <span class="input-hint">Primary email for communication</span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="mx-label">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" class="mx-input" placeholder="(555) 123-4567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    <span class="input-hint">Primary contact number</span>
                </div>

                <div class="form-grid-full">
                    <label asp-for="Address" class="mx-label">Address</label>
                    <textarea asp-for="Address" class="mx-input" rows="2" placeholder="Enter full address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                    <span class="input-hint">Complete mailing address</span>
                </div>
            </div>
        </div>
    </div>

    <!-- EMPLOYMENT INFORMATION SECTION -->
    <div class="form-section-card">
        <div class="card-header-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            <h2>Employment Information</h2>
        </div>

        <div class="form-section-body">
            <div class="form-grid">
                <div>
                    <label asp-for="Position" class="mx-label">Position/Title</label>
                    <input asp-for="Position" class="mx-input" placeholder="e.g., Senior Technician" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                    <span class="input-hint">Job title or position</span>
                </div>

                <div>
                    <label asp-for="Department" class="mx-label">Department</label>
                    <input asp-for="Department" class="mx-input" list="departmentList" placeholder="Select or enter department" />
                    <datalist id="departmentList">
                        @foreach (var dept in Model.AvailableDepartments)
                        {
                            <option value="@dept"></option>
                        }
                    </datalist>
                    <span asp-validation-for="Department" class="text-danger"></span>
                    <span class="input-hint">Organizational department</span>
                </div>

                <div>
                    <label asp-for="EmploymentType" class="mx-label">Employment Type</label>
                    <select asp-for="EmploymentType" class="mx-select">
                        <option value="">Select employment type</option>
                        @foreach (var type in Model.AvailableEmploymentTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                    <span asp-validation-for="EmploymentType" class="text-danger"></span>
                    <span class="input-hint">Full-time, part-time, contract, etc.</span>
                </div>

                <div>
                    <label asp-for="Status" class="mx-label">Status <span class="required">*</span></label>
                    <select asp-for="Status" class="mx-select" required>
                        @foreach (var status in Model.AvailableStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                    <span class="input-hint">Current employment status</span>
                </div>

                <div>
                    <label asp-for="HireDate" class="mx-label">Hire Date</label>
                    <input asp-for="HireDate" type="date" class="mx-input" />
                    <span asp-validation-for="HireDate" class="text-danger"></span>
                    <span class="input-hint">Date employee was hired</span>
                </div>

                <div>
                    <label asp-for="TerminationDate" class="mx-label">Termination Date</label>
                    <input asp-for="TerminationDate" type="date" class="mx-input" />
                    <span asp-validation-for="TerminationDate" class="text-danger"></span>
                    <span class="input-hint">Leave blank if currently employed</span>
                </div>

                <div>
                    <label asp-for="Role" class="mx-label">Job Role</label>
                    <input asp-for="Role" class="mx-input" placeholder="e.g., Technician, Supervisor" />
                    <span asp-validation-for="Role" class="text-danger"></span>
                    <span class="input-hint">Functional role in operations</span>
                </div>

                <div>
                    <label asp-for="HourlyRate" class="mx-label">Hourly Rate ($)</label>
                    <input asp-for="HourlyRate" type="number" step="0.01" class="mx-input" placeholder="0.00" />
                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    <span class="input-hint">Compensation rate per hour</span>
                </div>

                <div class="form-grid-full">
                    <label asp-for="SkillSet" class="mx-label">Skills & Certifications</label>
                    <input asp-for="SkillSet" class="mx-input" placeholder="e.g., HVAC, Electrical, Plumbing" />
                    <span asp-validation-for="SkillSet" class="text-danger"></span>
                    <span class="input-hint">Comma-separated list of skills and certifications</span>
                </div>
            </div>
        </div>
    </div>

    <!-- EMERGENCY CONTACT SECTION -->
    <div class="form-section-card">
        <div class="card-header-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <h2>Emergency Contact</h2>
        </div>

        <div class="form-section-body">
            <div class="form-grid">
                <div>
                    <label asp-for="EmergencyContactName" class="mx-label">Contact Name</label>
                    <input asp-for="EmergencyContactName" class="mx-input" placeholder="Enter emergency contact name" />
                    <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
                    <span class="input-hint">Person to contact in case of emergency</span>
                </div>

                <div>
                    <label asp-for="EmergencyContactPhone" class="mx-label">Contact Phone</label>
                    <input asp-for="EmergencyContactPhone" type="tel" class="mx-input" placeholder="(555) 123-4567" />
                    <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
                    <span class="input-hint">Emergency contact phone number</span>
                </div>
            </div>
        </div>
    </div>

    <!-- USER ACCOUNT LINK SECTION -->
    <div class="form-section-card">
        <div class="card-header-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            <h2>User Account Link (Optional)</h2>
        </div>

        <div class="form-section-body">
            <div class="form-grid">
                <div class="form-grid-full">
                    <label asp-for="UserId" class="mx-label">Link to User Account</label>
                    <select asp-for="UserId" class="mx-select">
                        <option value="">No user account</option>
                        @foreach (var user in Model.AvailableUserAccounts)
                        {
                            <option value="@user.UserId" selected="@(user.IsLinked ? "selected" : null)">@user.FullName (@user.Email)</option>
                        }
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                    <span class="input-hint">Link this personnel record to an existing user account for system access and authentication</span>
                </div>
            </div>
        </div>
    </div>

    <!-- NOTES SECTION -->
    <div class="form-section-card">
        <div class="card-header-compact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
            </svg>
            <h2>Additional Notes</h2>
        </div>

        <div class="form-section-body">
            <div class="form-grid">
                <div class="form-grid-full">
                    <label asp-for="Notes" class="mx-label">Notes</label>
                    <textarea asp-for="Notes" class="mx-input" rows="4" placeholder="Enter any additional notes or comments about this personnel"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                    <span class="input-hint">Internal notes, special instructions, or other relevant information</span>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM ACTIONS (STICKY FOOTER) -->
    <div class="form-section-card">
        <div class="form-actions-sticky">
            <button type="button" class="btn-modal-cancel" onclick="window.location.href='/admin/personnel/@Model.PersonnelId'">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Cancel
            </button>
            <button type="submit" class="btn-modal-submit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><polyline points="20 6 9 17 4 12"/></svg>
                Update Personnel
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
