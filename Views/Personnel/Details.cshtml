@model IT15_Project.Models.ViewModels.PersonnelDetailsViewModel
@{
    ViewData["Title"] = $"Personnel - {Model.FullName}";
    ViewData["Active"] = "Personnel";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/maintenx-role-badges.css" asp-append-version="true" />

<!-- ══════════════════════════════════════
     PAGE HEADER WITH BREADCRUMB
════════════════════════════════════════ -->
<div class="personnel-details-header">
    <div class="header-top-row">
        <button class="btn-back-compact" onclick="window.location.href='/admin/personnel'">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Back
        </button>
        <div class="breadcrumb-compact">
            <a href="/admin/personnel">Personnel</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            <span>@Model.FullName</span>
        </div>
    </div>
    <div class="header-main-row">
        <div class="header-title-group">
            <h1>@Model.FullName</h1>
            @await Html.PartialAsync("_PersonnelStatusBadge", Model.Status)
        </div>
        @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
        {
            <button class="btn-primary-mx" onclick="window.location.href='/admin/personnel/@Model.PersonnelId/edit'">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Edit Personnel
            </button>
        }
    </div>
    <div class="header-meta">
        <span class="meta-item">@(Model.Position ?? "Personnel")</span>
        <span class="meta-divider">•</span>
        <span class="meta-item">Employee ID: @(Model.EmployeeId ?? "N/A")</span>
    </div>
</div>

<!-- ══════════════════════════════════════
     TWO-COLUMN RESPONSIVE LAYOUT
════════════════════════════════════════ -->
<div class="details-layout">

    <!-- LEFT COLUMN -->
    <div class="details-main">

        <!-- PROFILE INFORMATION -->
        <div class="card">
            <div class="card-header-compact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
                <h2>Profile Information</h2>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Full Name</div>
                    <div class="info-value">@Model.FullName</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Employee ID</div>
                    <div class="info-value info-value-mono">@(Model.EmployeeId ?? "N/A")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <a href="mailto:@Model.Email" style="color:var(--mx-blue);text-decoration:none;">@Model.Email</a>
                        }
                        else
                        {
                            <span class="info-value-empty">N/A</span>
                        }
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Phone Number</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <a href="tel:@Model.PhoneNumber" style="color:var(--mx-blue);text-decoration:none;">@Model.PhoneNumber</a>
                        }
                        else
                        {
                            <span class="info-value-empty">N/A</span>
                        }
                    </div>
                </div>
                <div class="info-item info-item-full">
                    <div class="info-label">Address</div>
                    <div class="info-value">@(Model.Address ?? "N/A")</div>
                </div>
            </div>
        </div>

        <!-- EMPLOYMENT INFORMATION -->
        <div class="card">
            <div class="card-header-compact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
                <h2>Employment Information</h2>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Position/Title</div>
                    <div class="info-value">@(Model.Position ?? "N/A")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Department</div>
                    <div class="info-value">@(Model.Department ?? "N/A")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Employment Type</div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.EmploymentType))
                        {
                            <span class="badge badge-employment-@Model.EmploymentType.ToLower()">@Model.EmploymentType</span>
                        }
                        else
                        {
                            <span class="info-value-empty">N/A</span>
                        }
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Job Role</div>
                    <div class="info-value">@(Model.Role ?? "N/A")</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Hire Date</div>
                    <div class="info-value">
                        @if (Model.HireDate.HasValue)
                        {
                            <span>@Model.HireDate.Value.ToString("MMMM dd, yyyy")</span>
                            <span class="info-value-meta">(@Model.DaysEmployed days)</span>
                        }
                        else
                        {
                            <span class="info-value-empty">N/A</span>
                        }
                    </div>
                </div>
                @if (Model.TerminationDate.HasValue)
                {
                    <div class="info-item">
                        <div class="info-label">Termination Date</div>
                        <div class="info-value" style="color:var(--mx-red);font-weight:600;">@Model.TerminationDate.Value.ToString("MMMM dd, yyyy")</div>
                    </div>
                }
                @if (Model.HourlyRate.HasValue)
                {
                    <div class="info-item">
                        <div class="info-label">Hourly Rate</div>
                        <div class="info-value info-value-highlight">$@Model.HourlyRate.Value.ToString("N2")/hr</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.SkillSet))
                {
                    <div class="info-item info-item-full">
                        <div class="info-label">Skills & Certifications</div>
                        <div class="skill-tags">
                            @foreach (var skill in Model.SkillSet.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="skill-tag">@skill.Trim()</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- EMERGENCY CONTACT -->
        @if (!string.IsNullOrEmpty(Model.EmergencyContactName) || !string.IsNullOrEmpty(Model.EmergencyContactPhone))
        {
            <div class="card">
                <div class="card-header-compact">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <h2>Emergency Contact</h2>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Contact Name</div>
                        <div class="info-value">@(Model.EmergencyContactName ?? "N/A")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Contact Phone</div>
                        <div class="info-value">
                            @if (!string.IsNullOrEmpty(Model.EmergencyContactPhone))
                            {
                                <a href="tel:@Model.EmergencyContactPhone" style="color:var(--mx-blue);text-decoration:none;">@Model.EmergencyContactPhone</a>
                            }
                            else
                            {
                                <span class="info-value-empty">N/A</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- NOTES -->
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card">
                <div class="card-header-compact">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <h2>Notes</h2>
                </div>
                <div class="card-content">
                    <p style="color:var(--mx-muted);line-height:1.6;white-space:pre-wrap;">@Model.Notes</p>
                </div>
            </div>
        }

        <!-- RECENT WORK ORDERS -->
        <div class="card">
            <div class="card-header-compact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                </svg>
                <h2>Recent Work Orders</h2>
                <span class="header-badge">@Model.RecentWorkOrders.Count recent</span>
            </div>

            @if (Model.RecentWorkOrders.Any())
            {
                <div style="overflow-x:auto;">
                    <table class="mx-table">
                        <thead>
                            <tr>
                                <th>WO Number</th>
                                <th>Asset</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var wo in Model.RecentWorkOrders)
                            {
                                <tr>
                                    <td>
                                        <a href="/dashboard/work-orders/@wo.WorkOrderId" class="table-link">
                                            @wo.WorkOrderNumber
                                        </a>
                                    </td>
                                    <td>@wo.AssetName</td>
                                    <td>
                                        @await Html.PartialAsync("_WorkOrderStatusBadge", wo.Status)
                                    </td>
                                    <td>
                                        @switch (wo.Priority)
                                        {
                                            case "Critical":
                                                <span class="badge badge-critical">Critical</span>
                                                break;
                                            case "High":
                                                <span class="badge badge-high">High</span>
                                                break;
                                            case "Medium":
                                                <span class="badge badge-medium">Medium</span>
                                                break;
                                            case "Low":
                                                <span class="badge badge-low">Low</span>
                                                break;
                                            default:
                                                <span class="badge">@wo.Priority</span>
                                                break;
                                        }
                                    </td>
                                    <td class="table-date">
                                        @wo.DateCreated.ToString("MMM dd, yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <p>No work orders assigned yet</p>
                </div>
            }
        </div>

    </div>

    <!-- RIGHT COLUMN (SIDEBAR) -->
    <div class="details-sidebar">

        <!-- QUICK ACTIONS -->
        @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
        {
            <div class="card">
                <div class="card-header-compact">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/>
                    </svg>
                    <h2>Quick Actions</h2>
                </div>

                <div class="action-list">
                    <button class="action-button" onclick="window.location.href='/admin/personnel/@Model.PersonnelId/edit'">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        Edit Personnel
                    </button>

                    @if (!Model.HasUserAccount)
                    {
                        <button class="action-button" onclick="alert('Link user feature - to be implemented')">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                            </svg>
                            Link User Account
                        </button>
                    }
                    else
                    {
                        <button class="action-button action-button-warning" onclick="unlinkUser(@Model.PersonnelId, '@Model.FullName')">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                            Unlink User Account
                        </button>
                    }

                    @if (Model.Status == "Active")
                    {
                        <button class="action-button action-button-danger" onclick="archivePersonnel(@Model.PersonnelId, '@Model.FullName')">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/>
                            </svg>
                            Archive Personnel
                        </button>
                    }
                    else
                    {
                        <button class="action-button action-button-success" onclick="reactivatePersonnel(@Model.PersonnelId, '@Model.FullName')">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            Reactivate Personnel
                        </button>
                    }
                </div>
            </div>
        }

        <!-- LINKED USER ACCOUNT -->
        <div class="card">
            <div class="card-header-compact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
                <h2>User Account</h2>
            </div>

            @if (Model.HasUserAccount)
            {
                <div class="user-account-compact">
                    <div class="account-info-row">
                        <div class="td-avatar-small">
                            @(Model.UserFullName?.Length >= 2 ? Model.UserFullName.Substring(0, 2).ToUpper() : "NA")
                        </div>
                        <div class="account-details">
                            <div class="account-name">@Model.UserFullName</div>
                            <div class="account-email">@Model.UserEmail</div>
                        </div>
                    </div>

                    @if (Model.UserRoles.Any())
                    {
                        <div class="account-roles">
                            <div class="info-label-small">Roles</div>
                            <div class="role-badges-compact">
                                @await Html.PartialAsync("_RoleBadge", Model.UserRoles)
                            </div>
                        </div>
                    }

                    <a href="/admin/users/@Model.UserId" class="btn-view-account">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                        View Account
                    </a>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                    </svg>
                    <p>No user account linked</p>
                    @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
                    {
                        <button class="btn-secondary-mx" onclick="alert('Link user feature - to be implemented')" style="margin-top:12px;">
                            Link Account
                        </button>
                    }
                </div>
            }
        </div>

        <!-- WORK ORDER METRICS -->
        <div class="card">
            <div class="card-header-compact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
                <h2>Work Order Metrics</h2>
            </div>

            <div class="metrics-list">
                <div class="metric-item">
                    <span class="metric-label">Active Work Orders</span>
                    <span class="metric-value metric-value-blue">@Model.ActiveWorkOrders</span>
                </div>
                <div class="metric-item">
                    <span class="metric-label">Completed Work Orders</span>
                    <span class="metric-value metric-value-green">@Model.CompletedWorkOrders</span>
                </div>
                <div class="metric-item metric-item-total">
                    <span class="metric-label">Total Work Orders</span>
                    <span class="metric-value">@Model.TotalWorkOrders</span>
                </div>
            </div>
        </div>

        <!-- METADATA -->
        <div class="card">
            <div class="card-header-compact">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                <h2>Record Information</h2>
            </div>

            <div class="metadata-list">
                <div class="metadata-item">
                    <span class="metadata-label">Created</span>
                    <span class="metadata-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="metadata-item">
                        <span class="metadata-label">Last Updated</span>
                        <span class="metadata-value">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                }
                <div class="metadata-item">
                    <span class="metadata-label">Company</span>
                    <span class="metadata-value">@Model.CompanyName</span>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script src="~/js/personnel-management.js"></script>
}
