@model IT15_Project.Models.ViewModels.SuperAdminCompanyDetailsViewModel
@{
    ViewData["Title"] = Model.Company.CompanyName;
    ViewData["Active"] = "Companies";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
    
    // Extract properties for cleaner access
    var company = Model.Company;
    var daysRemaining = Model.DaysRemaining;
    var subscriptionExpiry = company.SubscriptionExpiry;
    var createdAt = company.CreatedAt;
}

<!-- ══════════════════════════════════════
     PAGE HEADER
════════════════════════════════════════ -->
<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
    <div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
            <h1 style="font-size:28px;font-weight:700;color:#1A2B4A;margin:0;">@company.CompanyName</h1>
            @await Html.PartialAsync("_CompanyStatusBadge", company.IsActive)
        </div>
        <div style="display:flex;align-items:center;gap:16px;color:var(--mx-muted);font-size:14px;">
            <span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;vertical-align:middle;margin-right:4px;">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
                @(company.ContactEmail ?? "No email")
            </span>
            <span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;vertical-align:middle;margin-right:4px;">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                @(company.SubscriptionPlan ?? "Free") Plan
            </span>
        </div>
    </div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/superadmin/companies" class="btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;margin-right:6px;">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Back to Companies
        </a>
        @if (company.IsActive)
        {
            <button onclick="suspendCompany(@company.CompanyId)" class="btn-danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;margin-right:6px;">
                    <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                </svg>
                Suspend Company
            </button>
        }
        else
        {
            <button onclick="reactivateCompany(@company.CompanyId)" class="btn-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;margin-right:6px;">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                Reactivate Company
            </button>
        }
        <button onclick="alert('Edit feature coming soon')" class="btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;margin-right:6px;">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Edit Subscription
        </button>
    </div>
</div>

<!-- ══════════════════════════════════════
     SUMMARY CARDS
════════════════════════════════════════ -->
<div class="stats-grid" style="margin-bottom:24px;">
    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <span class="stat-trend">@Model.UserCount / @(company.MaxUsers?.ToString() ?? "∞")</span>
        </div>
        <div class="stat-value">@Model.UserCount</div>
        <div class="stat-label">Total Users</div>
    </div>

    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                </svg>
            </div>
            <span class="stat-trend">@Model.AssetCount / @(company.MaxAssets?.ToString() ?? "∞")</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@Model.AssetCount</div>
        <div class="stat-label">Total Assets</div>
    </div>

    <div class="stat-card navy">
        <div class="stat-top">
            <div class="stat-icon navy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.WorkOrderCount</span>
        </div>
        <div class="stat-value" style="color:var(--mx-navy)">@Model.WorkOrderCount</div>
        <div class="stat-label">Work Orders</div>
    </div>

    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <span class="stat-trend">Active</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@Model.TechnicianCount</div>
        <div class="stat-label">Technicians</div>
    </div>

    <div class="stat-card purple">
        <div class="stat-top">
            <div class="stat-icon purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
            </div>
            @if (daysRemaining.HasValue)
            {
                if (daysRemaining.Value < 0)
                {
                    <span class="stat-trend warn">Expired</span>
                }
                else if (daysRemaining.Value <= 30)
                {
                    <span class="stat-trend warn">@daysRemaining days left</span>
                }
                else
                {
                    <span class="stat-trend up">@daysRemaining days</span>
                }
            }
            else
            {
                <span class="stat-trend">N/A</span>
            }
        </div>
        <div class="stat-value" style="color:#667eea;">
            @if (subscriptionExpiry.HasValue)
            {
                @subscriptionExpiry.Value.ToString("MMM dd")
            }
            else
            {
                <span style="font-size:18px;">N/A</span>
            }
        </div>
        <div class="stat-label">Subscription Expiry</div>
    </div>
</div>

<!-- ══════════════════════════════════════
     ROW 1 — COMPANY INFO + SUBSCRIPTION
════════════════════════════════════════ -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:20px;margin-bottom:20px;">
    
    <!-- Company Information -->
    <div class="card">
        <div class="section-header">
            <h2>Company Information</h2>
        </div>
        <div style="padding:0 20px 20px;">
            <div class="info-row">
                <span class="info-label">Company Name</span>
                <span class="info-value">@company.CompanyName</span>
            </div>
            <div class="info-row">
                <span class="info-label">Contact Email</span>
                <span class="info-value">@(company.ContactEmail ?? "Not provided")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Contact Phone</span>
                <span class="info-value">@(company.ContactPhone ?? "Not provided")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Address</span>
                <span class="info-value">@(company.Address ?? "Not provided")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Created Date</span>
                <span class="info-value">@createdAt.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-value">
                    @await Html.PartialAsync("_CompanyStatusBadge", company.IsActive)
                </span>
            </div>
        </div>
    </div>

    <!-- Subscription Details -->
    <div class="card">
        <div class="section-header">
            <h2>Subscription Details</h2>
        </div>
        <div style="padding:0 20px 20px;">
            <div class="info-row">
                <span class="info-label">Current Plan</span>
                <span class="info-value">
                    @{
                        var planColor = (company.SubscriptionPlan ?? "Free") switch
                        {
                            "Free" => "background:#F1F5F9;color:#64748B",
                            "Starter" => "background:#DBEAFE;color:#1E40AF",
                            "Professional" => "background:#EDE9FE;color:#6B21A8",
                            "Enterprise" => "background:#FEF3C7;color:#92400E",
                            _ => "background:#F1F5F9;color:#64748B"
                        };
                    }
                    <span class="badge" style="@planColor;padding:4px 10px;font-size:11px;font-weight:600;">@(company.SubscriptionPlan ?? "Free")</span>
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">User Limit</span>
                <span class="info-value">
                    <span style="font-weight:600;color:#1A2B4A;">@Model.UserCount</span>
                    <span style="color:var(--mx-muted);"> / @(company.MaxUsers?.ToString() ?? "Unlimited")</span>
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Asset Limit</span>
                <span class="info-value">
                    <span style="font-weight:600;color:#1A2B4A;">@Model.AssetCount</span>
                    <span style="color:var(--mx-muted);"> / @(company.MaxAssets?.ToString() ?? "Unlimited")</span>
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Expiration Date</span>
                <span class="info-value">
                    @if (subscriptionExpiry.HasValue)
                    {
                        @subscriptionExpiry.Value.ToString("MMMM dd, yyyy")
                    }
                    else
                    {
                        <span style="color:var(--mx-muted);">No expiration</span>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Days Remaining</span>
                <span class="info-value">
                    @if (daysRemaining.HasValue)
                    {
                        if (daysRemaining.Value < 0)
                        {
                            <span class="badge" style="background:#FEE2E2;color:#991B1B;padding:4px 10px;font-size:11px;font-weight:600;">Expired</span>
                        }
                        else if (daysRemaining.Value <= 30)
                        {
                            <span class="badge badge-warning" style="padding:4px 10px;font-size:11px;">@daysRemaining days</span>
                        }
                        else
                        {
                            <span style="font-weight:600;color:var(--mx-green);">@daysRemaining days</span>
                        }
                    }
                    else
                    {
                        <span style="color:var(--mx-muted);">N/A</span>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Billing Email</span>
                <span class="info-value">@(company.BillingEmail ?? company.ContactEmail ?? "Not provided")</span>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════
     ROW 2 — RECENT ACTIVITY
════════════════════════════════════════ -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(500px,1fr));gap:20px;margin-bottom:20px;">
    
    <!-- Recent Work Orders -->
    <div class="card">
        <div class="section-header">
            <h2>Recent Work Orders</h2>
            <span class="view-all">Last 5</span>
        </div>
        @if (Model.RecentWorkOrders.Count > 0)
        {
            <div style="overflow-x:auto;">
                <table class="mx-table">
                    <thead>
                        <tr>
                            <th>WO #</th>
                            <th>Asset</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var wo in Model.RecentWorkOrders)
                        {
                            var statusClass = wo.Status switch
                            {
                                "Completed" => "badge-done",
                                "In Progress" => "badge-inprog",
                                "Pending" => "badge-pending",
                                "Cancelled" => "badge-cancelled",
                                _ => "badge-pending"
                            };
                            
                            var priorityClass = wo.Priority?.ToLower() switch
                            {
                                "high" => "badge-high",
                                "medium" => "badge-med",
                                "low" => "badge-low",
                                _ => "badge-med"
                            };
                            
                            <tr>
                                <td class="td-id">#@wo.WorkOrderNumber</td>
                                <td class="td-equip">@wo.AssetName</td>
                                <td><span class="badge @statusClass">@wo.Status</span></td>
                                <td><span class="badge @priorityClass">@wo.Priority</span></td>
                                <td style="color:var(--mx-muted);font-size:12px;">@wo.DateCreated.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:40px;text-align:center;color:var(--mx-muted);">
                <p>No work orders yet.</p>
            </div>
        }
    </div>

    <!-- Recent Maintenance Requests -->
    <div class="card">
        <div class="section-header">
            <h2>Recent Maintenance Requests</h2>
            <span class="view-all">Last 5</span>
        </div>
        @if (Model.RecentRequests.Count > 0)
        {
            <div style="overflow-x:auto;">
                <table class="mx-table">
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Asset</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.RecentRequests)
                        {
                            var statusClass = req.Status switch
                            {
                                "Converted" => "badge-done",
                                "Approved" => "badge-inprog",
                                "Pending" => "badge-pending",
                                "Rejected" => "badge-cancelled",
                                _ => "badge-pending"
                            };
                            
                            var priorityClass = req.Priority?.ToLower() switch
                            {
                                "high" => "badge-high",
                                "medium" => "badge-med",
                                "low" => "badge-low",
                                _ => "badge-med"
                            };
                            
                            <tr>
                                <td class="td-id">#@req.RequestNumber</td>
                                <td class="td-equip">@req.AssetName</td>
                                <td><span class="badge @statusClass">@req.Status</span></td>
                                <td><span class="badge @priorityClass">@req.Priority</span></td>
                                <td style="color:var(--mx-muted);font-size:12px;">@req.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:40px;text-align:center;color:var(--mx-muted);">
                <p>No maintenance requests yet.</p>
            </div>
        }
    </div>
</div>

<!-- ══════════════════════════════════════
     ROW 3 — RECENT USERS
════════════════════════════════════════ -->
<div class="card">
    <div class="section-header">
        <h2>Recent Users</h2>
        <span class="view-all">Last 5</span>
    </div>
    @if (Model.RecentUsers.Count > 0)
    {
        <div style="overflow-x:auto;">
            <table class="mx-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.RecentUsers)
                    {
                        <tr>
                            <td class="td-equip">@(user.FullName ?? "N/A")</td>
                            <td style="color:var(--mx-muted);font-size:13px;">@user.Email</td>
                            <td>
                                @if (!string.IsNullOrEmpty(user.Personnel))
                                {
                                    <span class="badge" style="background:#EDE9FE;color:#6B21A8;padding:4px 10px;font-size:11px;font-weight:600;">@user.Personnel</span>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);font-size:12px;">No role</span>
                                }
                            </td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge badge-done">Verified</span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="padding:40px;text-align:center;color:var(--mx-muted);">
            <p>No users yet.</p>
        </div>
    }
</div>

@section Scripts {
<script>
    async function suspendCompany(companyId) {
        if (!confirm('Are you sure you want to suspend this company? All users will be unable to log in.')) {
            return;
        }

        try {
            const response = await fetch(`/superadmin/companies/${companyId}/suspend`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();
            if (result.success) {
                alert('Company suspended successfully');
                location.reload();
            } else {
                alert('Failed to suspend company');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred');
        }
    }

    async function reactivateCompany(companyId) {
        if (!confirm('Are you sure you want to reactivate this company?')) {
            return;
        }

        try {
            const response = await fetch(`/superadmin/companies/${companyId}/reactivate`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const result = await response.json();
            if (result.success) {
                alert('Company reactivated successfully');
                location.reload();
            } else {
                alert('Failed to reactivate company');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred');
        }
    }
</script>

<style>
    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #F1F5F9;
    }
    
    .info-row:last-child {
        border-bottom: none;
    }
    
    .info-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--mx-muted);
    }
    
    .info-value {
        font-size: 14px;
        font-weight: 600;
        color: #1A2B4A;
        text-align: right;
    }
    
    .btn-primary, .btn-secondary, .btn-danger, .btn-success {
        display: inline-flex;
        align-items: center;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    
    .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }
    
    .btn-secondary {
        background: white;
        color: #64748B;
        border: 1px solid #E2E8F0;
    }
    
    .btn-secondary:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
    }
    
    .btn-danger {
        background: #EF4444;
        color: white;
    }
    
    .btn-danger:hover {
        background: #DC2626;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }
    
    .btn-success {
        background: #22C55E;
        color: white;
    }
    
    .btn-success:hover {
        background: #16A34A;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }
    
    .stat-card.purple .stat-icon.purple {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        color: #667eea;
    }
</style>
}
