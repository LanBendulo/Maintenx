@model IT15_Project.Models.ViewModels.PublicPricingViewModel

@{
    ViewData["Title"] = "MaintenX - Maintenance Management System";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-badge">
                    <span>Made for Modern Enterprises</span>
                    <span class="badge-icons">
                        <i class="bi bi-check-circle-fill"></i>
                        <i class="bi bi-shield-check"></i>
                        <i class="bi bi-lightning-fill"></i>
                    </span>
                </div>
                
                <h1 class="hero-title">
                    Enterprise maintenance management with
                    <span class="text-gradient">automated workflows</span> and complete operational visibility.
                </h1>
                
                <p class="hero-subtitle">
                    Built for Facility Managers & Maintenance Teams • Work Order Automation • Parts Inventory Tracking • Cost Management • Multi-Tenant Architecture
                </p>
                
                <div class="hero-cta">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg">
                        <i class="bi bi-person-plus"></i> Sign Up Free
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In
                    </a>
                </div>
                
                <div class="hero-note">
                    <small><i class="bi bi-check-circle-fill text-success"></i> No credit card required • 14-day free trial</small>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="hero-image">
                    <div class="floating-card card-1">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Work Orders</span>
                    </div>
                    <div class="floating-card card-2">
                        <i class="bi bi-calendar-event"></i>
                        <span>Preventive Maintenance</span>
                    </div>
                    <div class="floating-card card-3">
                        <i class="bi bi-currency-dollar"></i>
                        <span>Cost Tracking</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="trust-banner">
            <p>Trusted by enterprises for operational excellence</p>
            <div class="trust-stats">
                <div class="stat-item">
                    <strong>Multi-Tenant</strong>
                    <span>Secure Isolation</span>
                </div>
                <div class="stat-item">
                    <strong>Real-Time</strong>
                    <span>Inventory Tracking</span>
                </div>
                <div class="stat-item">
                    <strong>Automated</strong>
                    <span>PM Generation</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section" id="features">
    <div class="container">
        <div class="section-header text-center">
            <h2>Powerful Features of MaintenX</h2>
            <p>Everything you need to manage maintenance operations efficiently</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <h3>Work Order Management</h3>
                    <p>Create, assign, and track work orders from start to completion. Automated lifecycle management with status tracking.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Digital work orders</li>
                        <li><i class="bi bi-check2"></i> Priority management</li>
                        <li><i class="bi bi-check2"></i> Real-time status tracking</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <h3>Preventive Maintenance</h3>
                    <p>Schedule and automate preventive maintenance tasks. Frequency-based scheduling with automatic work order generation.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Automated scheduling</li>
                        <li><i class="bi bi-check2"></i> Frequency-based triggers</li>
                        <li><i class="bi bi-check2"></i> PM governance tracking</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h3>Parts Inventory Management</h3>
                    <p>Track spare parts inventory with consumption tracking. Staged parts workflow with automatic inventory deduction.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Real-time stock tracking</li>
                        <li><i class="bi bi-check2"></i> Reorder level alerts</li>
                        <li><i class="bi bi-check2"></i> Consumption history</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-graph-up"></i>
                    </div>
                    <h3>Inventory Movement Tracking</h3>
                    <p>Complete audit trail of all inventory mutations. Immutable movement logs with before/after quantity tracking.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Immutable audit logs</li>
                        <li><i class="bi bi-check2"></i> Movement type tracking</li>
                        <li><i class="bi bi-check2"></i> User traceability</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <h3>Cost Tracking</h3>
                    <p>Monitor maintenance costs across work orders and assets. Labor, parts, and other cost breakdown with reporting.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Cost breakdown analysis</li>
                        <li><i class="bi bi-check2"></i> Asset cost tracking</li>
                        <li><i class="bi bi-check2"></i> Budget monitoring</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h3>Maintenance Requests</h3>
                    <p>Allow users to submit maintenance requests. Automated workflow from request to work order creation.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> User-submitted requests</li>
                        <li><i class="bi bi-check2"></i> Request lifecycle tracking</li>
                        <li><i class="bi bi-check2"></i> Auto work order creation</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3>Personnel Management</h3>
                    <p>Manage technicians and maintenance staff. Role-based access control with Owner, Admin, Technician, and User roles.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Role-based permissions</li>
                        <li><i class="bi bi-check2"></i> Task assignment</li>
                        <li><i class="bi bi-check2"></i> Performance tracking</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <h3>Maintenance Logs</h3>
                    <p>Automatic maintenance history logging. Complete records of all completed work with cost snapshots.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Auto-generated logs</li>
                        <li><i class="bi bi-check2"></i> Historical records</li>
                        <li><i class="bi bi-check2"></i> Cost snapshots</li>
                    </ul>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-building"></i>
                    </div>
                    <h3>Multi-Tenant Architecture</h3>
                    <p>Secure multi-company support with complete data isolation. Each company has its own secure workspace.</p>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2"></i> Company isolation</li>
                        <li><i class="bi bi-check2"></i> Subscription management</li>
                        <li><i class="bi bi-check2"></i> Enterprise-grade security</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="about-section" id="about">
    <div class="container">
        <div class="section-header text-center">
            <h2>About MaintenX</h2>
            <p>Built for Modern Enterprises</p>
        </div>
        
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h3>Our Mission</h3>
                <p class="lead">
                    MaintenX is an enterprise-grade CMMS (Computerized Maintenance Management System) designed to streamline maintenance operations for modern facilities and organizations.
                </p>
                <p>
                    Built with a focus on operational efficiency, MaintenX provides complete visibility into work orders, preventive maintenance schedules, parts inventory consumption, and maintenance costs—all within a secure multi-tenant architecture.
                </p>
                
                <div class="stats-grid">
                    <div class="stat-box">
                        <h4>Enterprise</h4>
                        <p>Grade Security</p>
                    </div>
                    <div class="stat-box">
                        <h4>Complete</h4>
                        <p>Audit Trails</p>
                    </div>
                    <div class="stat-box">
                        <h4>Real-Time</h4>
                        <p>Operations</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="why-choose">
                    <h3>Why Choose MaintenX</h3>
                    <div class="benefit-item">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <div>
                            <h4>Complete Workflow Automation</h4>
                            <p>Automated PM generation, work order lifecycle management, and inventory consumption tracking.</p>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <h4>Enterprise-Grade Architecture</h4>
                            <p>Multi-tenant isolation, immutable audit logs, and transactional inventory safety.</p>
                        </div>
                    </div>
                    <div class="benefit-item">
                        <i class="bi bi-graph-up-arrow"></i>
                        <div>
                            <h4>Operational Visibility</h4>
                            <p>Real-time cost tracking, inventory movement logs, and maintenance history reporting.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section class="pricing-section" id="pricing">
    <div class="container">
        <div class="section-header text-center">
            <h2>Flexible Pricing for Every Organization</h2>
            <p>Choose the plan that matches your operational scale</p>
        </div>
        
        @if (Model.Plans != null && Model.Plans.Any())
        {
            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model.Plans)
                {
                    var isFeatured = plan.Name.Contains("Professional", StringComparison.OrdinalIgnoreCase);
                    var isStarter = plan.Name.Contains("Starter", StringComparison.OrdinalIgnoreCase) && plan.IsFree;
                    var isEnterprise = plan.Name.Contains("Enterprise", StringComparison.OrdinalIgnoreCase);
                    
                    <div class="col-lg-4">
                        <div class="pricing-card @(isFeatured ? "featured" : "")">
                            @if (isStarter)
                            {
                                <div class="pricing-badge">Free Trial</div>
                            }
                            else if (isFeatured)
                            {
                                <div class="pricing-badge popular">Most Popular</div>
                            }
                            
                            <h3>@plan.Name</h3>
                            <p>@(plan.Description ?? "Perfect for your maintenance needs")</p>
                            
                            @if (isStarter && plan.IsFree)
                            {
                                <div class="price">
                                    <span class="amount">14</span>
                                    <span class="period">days free</span>
                                </div>
                                <p class="price-note">No credit card required</p>
                            }
                            else if (isEnterprise && plan.MonthlyPrice == 0)
                            {
                                <div class="price">
                                    <span class="amount">Custom</span>
                                </div>
                                <p class="price-note">Tailored to your needs</p>
                            }
                            else
                            {
                                <div class="price">
                                    <span class="currency">$</span>
                                    <span class="amount">@plan.MonthlyPrice.ToString("N0")</span>
                                    <span class="period">/month</span>
                                </div>
                                @if (plan.YearlyPrice > 0)
                                {
                                    <p class="price-note">Billed annually at $@plan.YearlyPrice.ToString("N0")</p>
                                }
                            }
                            
                            <ul class="pricing-features">
                                @if (plan.MaxAssets.HasValue)
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> Up to @plan.MaxAssets Assets</li>
                                }
                                else
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> Unlimited Assets</li>
                                }
                                
                                @if (plan.MaxUsers.HasValue)
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> @(plan.MaxUsers == 1 ? "1 User" : $"Up to {plan.MaxUsers} Users")</li>
                                }
                                else
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> Unlimited Users</li>
                                }
                                
                                @* Display custom features if available *@
                                @if (plan.Features != null && plan.Features.Any())
                                {
                                    @foreach (var feature in plan.Features)
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i> @feature</li>
                                    }
                                }
                                else
                                {
                                    @* Default features based on plan type *@
                                    @if (isStarter)
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i> Work Order Management</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Basic Parts Inventory</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Email Support</li>
                                    }
                                    else if (isFeatured)
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i> Preventive Maintenance</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Parts Inventory Management</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Cost Tracking & Reports</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Priority Support</li>
                                    }
                                    else if (isEnterprise)
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i> All Features Included</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Custom Workflows</li>
                                        <li><i class="bi bi-check-circle-fill"></i> API Access</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Dedicated Account Manager</li>
                                        <li><i class="bi bi-check-circle-fill"></i> 24/7 Priority Support</li>
                                    }
                                    else
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i> All Core Features</li>
                                        <li><i class="bi bi-check-circle-fill"></i> Standard Support</li>
                                    }
                                }
                                
                                @if (plan.MaxWorkOrdersPerMonth.HasValue)
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> Up to @plan.MaxWorkOrdersPerMonth Work Orders/Month</li>
                                }
                            </ul>
                            
                            @if (isEnterprise && plan.MonthlyPrice == 0)
                            {
                                <a href="#contact" class="btn btn-outline-primary w-100">Contact Sales</a>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Register" class="btn @(isFeatured ? "btn-primary" : "btn-outline-primary") w-100">
                                    @(isStarter ? "Start Free Trial" : "Get Started")
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @* Fallback if no plans are available *@
            <div class="row g-4 justify-content-center">
                <div class="col-lg-8">
                    <div class="alert alert-info text-center" role="alert">
                        <i class="bi bi-info-circle"></i>
                        <h4 class="alert-heading">Pricing Plans Coming Soon</h4>
                        <p>We're currently setting up our subscription plans. Please check back soon or contact us for more information.</p>
                        <hr>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Sign Up for Updates</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Contact Section -->
<section class="contact-section" id="contact">
    <div class="container">
        <div class="section-header text-center">
            <h2>Contact MaintenX</h2>
            <p>Get in touch with our team to learn how MaintenX can transform your maintenance operations</p>
        </div>
        
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="contact-form-wrapper">
                    <h3>Send us a message</h3>
                    <form id="contactForm">
                        <div class="mb-3">
                            <label for="name" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="company" class="form-label">Company Name</label>
                            <input type="text" class="form-control" id="company">
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control" id="message" rows="5" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send Message</button>
                    </form>
                </div>
            </div>
            
            <div class="col-lg-6">
                <div class="contact-info">
                    <h3>Get in Touch</h3>
                    
                    <div class="info-item">
                        <i class="bi bi-geo-alt-fill"></i>
                        <div>
                            <h4>Our Office</h4>
                            <p>123 Business Street<br>City, State 12345</p>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <h4>Phone</h4>
                            <p>(555) 123-4567<br>Mon-Fri, 9am-6pm</p>
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <i class="bi bi-envelope-fill"></i>
                        <div>
                            <h4>Email</h4>
                            <p>info@maintenx.com<br>support@maintenx.com</p>
                        </div>
                    </div>
                    
                    <div class="social-links">
                        <h4>Follow Us</h4>
                        <div class="social-icons">
                            <a href="#"><i class="bi bi-facebook"></i></a>
                            <a href="#"><i class="bi bi-twitter"></i></a>
                            <a href="#"><i class="bi bi-linkedin"></i></a>
                            <a href="#"><i class="bi bi-instagram"></i></a>
                        </div>
                    </div>
                    
                    <div class="cta-box">
                        <h4>Ready to streamline your maintenance?</h4>
                        <p>Book a free demo with our team to see how MaintenX can simplify your operations.</p>
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Book a Free Demo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you for your message! We will get back to you soon.');
            this.reset();
        });
    </script>
}
