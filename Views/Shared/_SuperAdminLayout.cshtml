@using Microsoft.AspNetCore.Identity
@inject UserManager<IT15_Project.Models.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MaintenX SuperAdmin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/maintenx-dashboard.css" asp-append-version="true" />
</head>
<body>
<div class="admin-shell">

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <aside class="sidebar">
        <!-- Logo -->
        <div class="sidebar-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="5" fill="none"/>
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="logo-text">Mainten<span>X</span></span>
            <span class="superadmin-badge">SUPER</span>
        </div>

        <!-- Nav -->
        <nav class="sidebar-nav">
            <!-- PLATFORM SECTION -->
            <div class="nav-section-label">Platform</div>

            <a href="/superadmin/dashboard" class="nav-item @(ViewData["Active"]?.ToString() == "Dashboard" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                Dashboard
            </a>

            <a href="/superadmin/companies" class="nav-item @(ViewData["Active"]?.ToString() == "Companies" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Companies
            </a>

            <a href="/superadmin/subscriptions" class="nav-item @(ViewData["Active"]?.ToString() == "Subscriptions" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
                Subscriptions
            </a>

            <a href="/superadmin/subscriptions/plans" class="nav-item @(ViewData["Active"]?.ToString() == "Plans" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                Subscription Plans
            </a>

            <!-- SYSTEM SECTION -->
            <div class="nav-section-label">System</div>

            <a href="/superadmin/users" class="nav-item @(ViewData["Active"]?.ToString() == "Users" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                All Users
            </a>

            <a href="/superadmin/analytics" class="nav-item @(ViewData["Active"]?.ToString() == "Analytics" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                Analytics
            </a>

            <a href="/superadmin/settings" class="nav-item @(ViewData["Active"]?.ToString() == "Settings" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                Platform Settings
            </a>
        </nav>

        <!-- User -->
        <div class="sidebar-user">
            @{
                var currentUser = await UserManager.GetUserAsync(User);
                var userInitials = currentUser?.FullName != null 
                    ? string.Join("", currentUser.FullName.Split(' ').Take(2).Select(n => n[0])).ToUpper()
                    : "SA";
            }
            <div class="user-avatar" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">@userInitials</div>
            <div class="user-info">
                <div class="user-name">@(currentUser?.FullName ?? "Super Administrator")</div>
                <span class="user-role" style="color: #667eea; font-weight: 600;">Super Admin</span>
            </div>
        </div>
    </aside>

    <!-- ═══════════ MAIN ═══════════ -->
    <div class="admin-main content-with-sidebar">

        <!-- Header -->
        <header class="admin-header">
            <div class="header-title">
                <h1>@(ViewData["Title"] ?? "Platform Dashboard")</h1>
                <div class="breadcrumb">
                    <a href="/superadmin/dashboard">Platform</a> &rsaquo; @(ViewData["Title"] ?? "Dashboard")
                </div>
            </div>
            <div class="header-right">
                <div class="superadmin-indicator">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px; color: #667eea;">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    <span style="color: #667eea; font-weight: 600; font-size: 13px;">SuperAdmin Mode</span>
                </div>
                <button class="btn-icon" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                </button>
                <div class="header-user">
                    <div class="h-avatar" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">@userInitials</div>
                    <span class="h-name">@(currentUser?.FullName?.Split(' ').FirstOrDefault() ?? "Admin")</span>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

<style>
    .superadmin-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 9px;
        font-weight: 700;
        padding: 3px 6px;
        border-radius: 4px;
        margin-left: 8px;
        letter-spacing: 0.5px;
    }
    
    .superadmin-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-radius: 8px;
        margin-right: 16px;
    }
</style>
</body>
</html>
