@using Microsoft.AspNetCore.Identity
@inject UserManager<IT15_Project.Models.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MaintenX Supervisor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/maintenx-dashboard.css" asp-append-version="true" />
</head>
<body>
<div class="admin-shell">

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <aside class="sidebar">
        <!-- Logo -->
        <div class="sidebar-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="5" fill="none"/>
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="logo-text">Mainten<span>X</span></span>
        </div>

        <!-- Nav -->
        <nav class="sidebar-nav">
            <!-- OVERSIGHT SECTION -->
            <div class="nav-section-label">Oversight</div>

            <a href="/supervisor/dashboard" class="nav-item @(ViewData["Active"]?.ToString() == "Dashboard" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                Dashboard
            </a>

            <a href="/supervisor/work-orders" class="nav-item @(ViewData["Active"]?.ToString() == "WorkOrders" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                </svg>
                Work Orders
            </a>

            <a href="/supervisor/pending-approvals" class="nav-item @(ViewData["Active"]?.ToString() == "PendingApprovals" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                Pending Approvals
                <span class="nav-badge" id="pending-approvals-badge" style="display:none;">0</span>
            </a>

            <a href="/supervisor/technician-oversight" class="nav-item @(ViewData["Active"]?.ToString() == "TechnicianOversight" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                Technician Oversight
            </a>

            <!-- MONITORING SECTION -->
            <div class="nav-section-label">Monitoring</div>

            <a href="/supervisor/pm-monitoring" class="nav-item @(ViewData["Active"]?.ToString() == "PmMonitoring" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                PM Monitoring
            </a>

            <a href="/supervisor/inventory-movements" class="nav-item @(ViewData["Active"]?.ToString() == "InventoryMovements" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
                Inventory Movements
            </a>

            <a href="/supervisor/maintenance-logs" class="nav-item @(ViewData["Active"]?.ToString() == "MaintenanceLogs" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="M9 15h6"/>
                </svg>
                Maintenance Logs
            </a>

            <a href="/supervisor/cost-tracking" class="nav-item @(ViewData["Active"]?.ToString() == "CostTracking" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
                Cost Tracking
            </a>
        </nav>

        <!-- User -->
        <div class="sidebar-user">
            @{
                var currentUser = await UserManager.GetUserAsync(User);
                var userInitials = currentUser?.FullName != null 
                    ? string.Join("", currentUser.FullName.Split(' ').Take(2).Select(n => n[0])).ToUpper()
                    : "SV";
            }
            <div class="user-avatar">@userInitials</div>
            <div class="user-info">
                <div class="user-name">@(currentUser?.FullName ?? "Supervisor")</div>
                <span class="user-role">Supervisor</span>
            </div>
        </div>
    </aside>

    <!-- ═══════════ MAIN ═══════════ -->
    <div class="admin-main content-with-sidebar">

        <!-- Header -->
        <header class="admin-header">
            <div class="header-title">
                <h1>@(ViewData["Title"] ?? "Supervisor Dashboard")</h1>
                <div class="breadcrumb">
                    <a href="/supervisor/dashboard">Supervisor</a> &rsaquo; @(ViewData["Title"] ?? "Dashboard")
                </div>
            </div>
            <div class="header-right">
                <div class="header-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" placeholder="Search…" />
                </div>
                <button class="btn-icon" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="notif-dot"></span>
                </button>
                <div class="header-user" id="userDropdownToggle">
                    <div class="h-avatar">@userInitials</div>
                    <span class="h-name">@(currentUser?.FullName?.Split(' ').FirstOrDefault() ?? "Supervisor")</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px; margin-left: 4px;">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
                <div class="user-dropdown-menu" id="userDropdownMenu">
                    <div class="dropdown-header">
                        <div class="dropdown-avatar">@userInitials</div>
                        <div class="dropdown-user-info">
                            <div class="dropdown-name">@(currentUser?.FullName ?? "Supervisor")</div>
                            <div class="dropdown-email">@(currentUser?.Email ?? "")</div>
                            <div class="dropdown-role">Supervisor</div>
                        </div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                        My Profile
                    </a>
                    <div class="dropdown-divider"></div>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" style="margin: 0;">
                        <button type="submit" class="dropdown-item dropdown-item-danger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // User dropdown toggle
    document.addEventListener('DOMContentLoaded', function() {
        const userDropdownToggle = document.getElementById('userDropdownToggle');
        const userDropdownMenu = document.getElementById('userDropdownMenu');
        
        if (userDropdownToggle && userDropdownMenu) {
            userDropdownToggle.addEventListener('click', function(e) {
                e.stopPropagation();
                userDropdownMenu.classList.toggle('show');
            });
            
            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!userDropdownToggle.contains(e.target) && !userDropdownMenu.contains(e.target)) {
                    userDropdownMenu.classList.remove('show');
                }
            });
        }
    });

    // Load pending approvals count
    (async function() {
        try {
            const response = await fetch('/supervisor/pending-approvals-count');
            if (response.ok) {
                const data = await response.json();
                const badge = document.getElementById('pending-approvals-badge');
                if (badge && data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'inline-block';
                }
            }
        } catch (error) {
            console.error('Failed to load pending approvals count:', error);
        }
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
