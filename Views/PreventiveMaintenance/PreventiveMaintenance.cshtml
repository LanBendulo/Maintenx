@model List<IT15_Project.Models.PreventiveSchedule>
@{
    ViewData["Title"] = "Preventive Maintenance";
    ViewData["Active"] = "PreventiveMaintenance";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Preventive Maintenance</h1>
        <p>Manage scheduled maintenance and generate work orders</p>
    </div>
    <button class="btn-primary-mx" id="openScheduleModal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
        Create Schedule
    </button>
</div>

<!-- SUMMARY CARDS -->
<div class="wo-stats">
    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <span class="stat-trend up">↑ @(Model?.Count ?? 0)</span>
        </div>
        <div class="stat-value">@(Model?.Count ?? 0)</div>
        <div class="stat-label">Total Schedules</div>
    </div>
    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <span class="stat-trend up">↑ @(Model?.Count(s => s.IsActive) ?? 0)</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@(Model?.Count(s => s.IsActive) ?? 0)</div>
        <div class="stat-label">Active Schedules</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <span class="stat-trend warn">● @(Model?.Count(s => s.IsActive && s.NextDueDate <= DateTime.Today.AddDays(7)) ?? 0)</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@(Model?.Count(s => s.IsActive && s.NextDueDate <= DateTime.Today.AddDays(7)) ?? 0)</div>
        <div class="stat-label">Due This Week</div>
    </div>
</div>

<!-- FILTER BAR -->
<div class="card" style="margin-bottom:20px;padding:18px 22px;">
    <div class="filter-bar" style="margin-bottom:0;">
        <div class="filter-search" style="max-width:300px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="pm-search" placeholder="Search title, asset…" />
        </div>
        <select class="filter-select" id="filter-status">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="all">All</option>
        </select>
        <button class="filter-reset" id="reset-filters">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
            Reset
        </button>
    </div>
</div>

<!-- SCHEDULES TABLE -->
<div class="card">
    <div class="section-header" style="margin-bottom:8px;">
        <h2>Maintenance Schedules</h2>
        <span id="row-count" class="table-meta">Showing <strong>@(Model?.Count ?? 0)</strong> results</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="mx-table" id="pm-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Asset</th>
                    <th>Frequency</th>
                    <th>Next Due</th>
                    <th>Last Completed</th>
                    <th>Default Technician</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="pm-tbody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var schedule in Model)
                    {
                        var statusClass = schedule.IsActive ? "done" : "cancelled";
                        var daysUntilDue = (schedule.NextDueDate - DateTime.Today).Days;
                        var isDueClass = daysUntilDue <= 0 ? "overdue" : daysUntilDue <= 7 ? "due-soon" : "";
                        
                        <tr data-status="@statusClass" data-due-class="@isDueClass">
                            <td class="td-id">@schedule.Title</td>
                            <td class="td-equip">@(schedule.Asset?.AssetName ?? "N/A")</td>
                            <td style="font-size:13px;color:var(--mx-muted)">Every @schedule.FrequencyDays days</td>
                            <td style="font-size:12.5px;">
                                @if (daysUntilDue <= 0)
                                {
                                    <span style="color:#EF4444;font-weight:600;">@schedule.NextDueDate.ToString("MMM dd, yyyy") (Overdue)</span>
                                }
                                else if (daysUntilDue <= 7)
                                {
                                    <span style="color:#F59E0B;font-weight:600;">@schedule.NextDueDate.ToString("MMM dd, yyyy") (@daysUntilDue days)</span>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);">@schedule.NextDueDate.ToString("MMM dd, yyyy")</span>
                                }
                            </td>
                            <td style="font-size:12.5px;color:var(--mx-muted)">@(schedule.LastCompletedDate?.ToString("MMM dd, yyyy") ?? "Never")</td>
                            <td>
                                @if (schedule.DefaultTechnician != null)
                                {
                                    <div class="td-staff">
                                        <div class="td-avatar">@($"{schedule.DefaultTechnician.FirstName?.FirstOrDefault()}{schedule.DefaultTechnician.LastName?.FirstOrDefault()}")</div>
                                        @schedule.DefaultTechnician.FullName
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--mx-muted);font-size:13px;">Unassigned</span>
                                }
                            </td>
                            <td><span class="badge badge-@statusClass">@(schedule.IsActive ? "Active" : "Inactive")</span></td>
                            <td style="text-align:right;">
                                <div class="action-menu">
                                    <button class="action-trigger">Actions <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
                                    <div class="action-dropdown">
                                        @if (schedule.IsActive)
                                        {
                                            <a href="#" class="action-generate-wo" data-schedule-id="@schedule.ScheduleId">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                                                Generate Work Order
                                            </a>
                                        }
                                        <a href="#" class="action-edit" data-schedule-id="@schedule.ScheduleId">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            Edit
                                        </a>
                                        <a href="#" class="action-toggle-status" data-schedule-id="@schedule.ScheduleId" data-is-active="@schedule.IsActive.ToString().ToLower()">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                            @(schedule.IsActive ? "Deactivate" : "Activate")
                                        </a>
                                        <a href="#" class="action-delete" data-schedule-id="@schedule.ScheduleId">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            Delete
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:40px;color:var(--mx-muted);">
                            No preventive maintenance schedules found. Click "Create Schedule" to add one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SUCCESS TOAST -->
<div class="mx-toast-success" id="pm-toast">
    <span class="toast-icon">✅</span>
    <span id="toast-message">Action completed successfully!</span>
</div>

<!-- CREATE/EDIT SCHEDULE MODAL -->
<div class="mx-modal-overlay" id="scheduleModal" role="dialog" aria-modal="true">
    <div class="mx-modal">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                    <div class="modal-title" id="modal-title">Create Preventive Maintenance Schedule</div>
                    <div class="modal-subtitle">Schedule regular maintenance for assets</div>
                </div>
            </div>
            <button class="modal-close" id="closeScheduleModal">×</button>
        </div>

        <div class="modal-body">
            <form id="scheduleForm" novalidate>
                <input type="hidden" id="schedule-id" />

                <!-- Asset & Title -->
                <div class="modal-section-label">Basic Information</div>
                <div class="modal-full">
                    <label class="mx-label">Asset <span class="required">*</span></label>
                    <select class="mx-select" id="schedule-asset" required>
                        <option value="">Select asset…</option>
                    </select>
                    <div class="input-error" id="err-asset">Please select an asset.</div>
                </div>
                <div class="modal-full">
                    <label class="mx-label">Title <span class="required">*</span></label>
                    <input type="text" class="mx-input" id="schedule-title" placeholder="e.g., Monthly HVAC Inspection" required />
                    <div class="input-error" id="err-title">Please enter a title.</div>
                </div>
                <div class="modal-full">
                    <label class="mx-label">Description</label>
                    <textarea class="mx-textarea" id="schedule-description" placeholder="Describe the maintenance tasks…"></textarea>
                </div>

                <!-- Scheduling -->
                <div class="modal-section-label">Schedule Settings</div>
                <div class="modal-grid-2">
                    <div>
                        <label class="mx-label">Frequency (Days) <span class="required">*</span></label>
                        <input type="number" class="mx-input" id="schedule-frequency" min="1" placeholder="e.g., 30" required />
                        <div class="input-hint">How often this maintenance should occur</div>
                        <div class="input-error" id="err-frequency">Please enter a valid frequency.</div>
                    </div>
                    <div>
                        <label class="mx-label">Next Due Date <span class="required">*</span></label>
                        <input type="date" class="mx-input" id="schedule-next-due" required />
                        <div class="input-error" id="err-next-due">Please select a due date.</div>
                    </div>
                </div>
                <div class="modal-full">
                    <label class="mx-label">Priority</label>
                    <select class="mx-select" id="schedule-priority">
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Low">Low</option>
                    </select>
                    <div class="input-hint">Affects work order completion timeframe (High: 2 days, Medium: 5 days, Low: 7 days)</div>
                </div>

                <!-- Assignment -->
                <div class="modal-section-label">Assignment (Optional)</div>
                <div class="modal-full">
                    <label class="mx-label">Default Technician</label>
                    <select class="mx-select" id="schedule-technician">
                        <option value="">Unassigned</option>
                    </select>
                    <div class="input-hint">Technician will be auto-assigned when work orders are generated</div>
                </div>
            </form>
        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancel" id="cancelScheduleModal">Cancel</button>
            <button class="btn-modal-submit" id="submitScheduleForm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span id="submit-btn-text">Create Schedule</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/preventive-maintenance.js" asp-append-version="true"></script>
}
