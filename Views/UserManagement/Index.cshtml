@model IT15_Project.Models.ViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
    ViewData["Active"] = "UserManagement";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/maintenx-role-badges.css" asp-append-version="true" />

<!-- ══════════════════════════════════════
     ROW 1 — SUMMARY CARDS
════════════════════════════════════════ -->
<div class="stats-grid">

    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.TotalUsers</span>
        </div>
        <div class="stat-value">@Model.TotalUsers.ToString("N0")</div>
        <div class="stat-label">Total Users</div>
    </div>

    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.ActiveUsers</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@Model.ActiveUsers</div>
        <div class="stat-label">Active Users</div>
    </div>

    <div class="stat-card navy">
        <div class="stat-top">
            <div class="stat-icon navy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.TechnicianCount</span>
        </div>
        <div class="stat-value" style="color:var(--mx-navy)">@Model.TechnicianCount</div>
        <div class="stat-label">Technicians</div>
    </div>

    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.AdminCount</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@Model.AdminCount</div>
        <div class="stat-label">Admins & Owners</div>
    </div>
</div>

<!-- ══════════════════════════════════════
     PAGE HEADER
════════════════════════════════════════ -->
<div class="page-header">
    <div class="page-header-left">
        <h1>User Management</h1>
        <p>Manage user accounts, roles, and access control</p>
    </div>
    @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
    {
        <button class="btn-primary-mx" onclick="window.location.href='/admin/users/create'">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
            </svg>
            Create User
        </button>
    }
</div>

<!-- ══════════════════════════════════════
     FILTER BAR
════════════════════════════════════════ -->
<div class="card" style="margin-bottom:20px;padding:18px 22px;">
    <div class="filter-bar" style="margin-bottom:0;">
        <div class="filter-search" style="max-width:300px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchInput" placeholder="Search by name or email…" />
        </div>
        <select class="filter-select" id="roleFilter">
            <option value="">All Roles</option>
            @foreach (var role in Model.AvailableRoles)
            {
                <option value="@role">@role</option>
            }
        </select>
        <select class="filter-select" id="statusFilter">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <button class="filter-reset" id="reset-filters">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
            Reset
        </button>
    </div>
</div>

<!-- ══════════════════════════════════════
     USER TABLE
════════════════════════════════════════ -->
<div class="card">
    <div class="section-header" style="margin-bottom:8px;">
        <h2>All Users</h2>
        <span id="row-count" class="table-meta">Showing <strong>@Model.Users.Count</strong> users</span>
    </div>

    <div style="overflow-x:auto;">
        <table class="mx-table" id="userTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Personnel Link</th>
                    <th>Last Login</th>
                    <th>Created</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr data-user-id="@user.Id" data-role="@string.Join(",", user.Roles)" data-status="@(user.IsActive ? "active" : "inactive")">
                        <td class="td-equip">
                            <div class="td-staff">
                                <div class="td-avatar" style="@(user.IsActive ? "" : "opacity:0.5;")">
                                    @(user.FullName.Length >= 2 ? user.FullName.Substring(0, 2).ToUpper() : user.FullName.ToUpper())
                                </div>
                                @user.FullName
                            </div>
                        </td>
                        <td style="color:var(--mx-muted);font-size:13px;">@user.Email</td>
                        <td>
                            @await Html.PartialAsync("_RoleBadge", user.Roles)
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge badge-done">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-cancelled">Inactive</span>
                            }
                            @if (!user.EmailConfirmed)
                            {
                                <span class="badge" style="background:rgba(250,204,21,.12);color:#ca8a04;margin-left:4px;font-size:11px;padding:3px 8px;">Unverified</span>
                            }
                        </td>
                        <td>
                            @if (user.HasPersonnelLink)
                            {
                                <a href="/admin/personnel/@user.PersonnelId" class="badge badge-inprog" style="text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;">
                                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                    </svg>
                                    @user.PersonnelName
                                </a>
                            }
                            else
                            {
                                <span style="color:var(--mx-muted);font-size:12px;">No link</span>
                            }
                        </td>
                        <td style="color:var(--mx-muted);font-size:12px;">
                            @if (user.LastLoginAt.HasValue)
                            {
                                @user.LastLoginAt.Value.ToString("MMM dd, yyyy")
                            }
                            else
                            {
                                <span>Never</span>
                            }
                        </td>
                        <td style="color:var(--mx-muted);font-size:12px;">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td style="text-align:right;">
                            @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
                            {
                                <div class="action-menu">
                                    <button class="action-trigger">Actions <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
                                    <div class="action-dropdown">
                                        <a href="/admin/users/@user.Id">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                            View Details
                                        </a>
                                        <a href="/admin/users/@user.Id/edit">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            Edit
                                        </a>
                                        <a href="#" onclick="openChangeRoleModal('@user.Id', '@user.FullName', '@string.Join(",", user.Roles)'); return false;">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                                            Change Role
                                        </a>
                                        <a href="#" onclick="openResetPasswordModal('@user.Id', '@user.FullName', '@user.Email'); return false;">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                            Reset Password
                                        </a>
                                        @if (user.IsActive)
                                        {
                                            <a href="#" onclick="deactivateUser('@user.Id', '@user.FullName'); return false;" style="color:var(--mx-red);">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                Deactivate
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="#" onclick="reactivateUser('@user.Id', '@user.FullName'); return false;" style="color:var(--mx-green);">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                                Reactivate
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <a href="/admin/users/@user.Id" class="action-trigger" style="text-decoration:none;">View</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Users.Any())
    {
        <div style="padding:40px;text-align:center;color:var(--mx-muted);">
            <p>No users found.</p>
        </div>
    }
</div>

<!-- ═══════════════════════════════════
     CHANGE ROLE MODAL
════════════════════════════════════ -->
<div class="mx-modal-overlay" id="changeRoleModal" role="dialog" aria-modal="true" style="display:none;">
    <div class="mx-modal" style="max-width:500px;">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon" style="background:rgba(244,121,32,.10);color:var(--mx-orange);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                </div>
                <div>
                    <div class="modal-title">Change User Role</div>
                    <div class="modal-subtitle" id="changeRoleUserName"></div>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal('changeRoleModal')" aria-label="Close">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="changeRoleUserId">
            <input type="hidden" id="changeRoleCurrentRole">
            <div class="modal-full">
                <label class="mx-label">New Role <span class="required">*</span></label>
                <select id="changeRoleNewRole" class="mx-select">
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('changeRoleModal')">Cancel</button>
            <button class="btn-modal-submit" onclick="submitChangeRole()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Change Role
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════
     RESET PASSWORD MODAL
════════════════════════════════════ -->
<div class="mx-modal-overlay" id="resetPasswordModal" role="dialog" aria-modal="true" style="display:none;">
    <div class="mx-modal" style="max-width:500px;">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon" style="background:rgba(239,68,68,.10);color:var(--mx-red);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                    <div class="modal-title">Reset Password</div>
                    <div class="modal-subtitle"><span id="resetPasswordUserName"></span> (<span id="resetPasswordEmail"></span>)</div>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal('resetPasswordModal')" aria-label="Close">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="resetPasswordUserId">
            <div class="modal-full">
                <label class="mx-label">New Password <span class="required">*</span></label>
                <input type="password" id="resetPasswordNew" class="mx-input" placeholder="Enter new password" required>
            </div>
            <div class="modal-full">
                <label class="mx-label">Confirm Password <span class="required">*</span></label>
                <input type="password" id="resetPasswordConfirm" class="mx-input" placeholder="Confirm new password" required>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('resetPasswordModal')">Cancel</button>
            <button class="btn-modal-submit" onclick="submitResetPassword()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Reset Password
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/user-management.js"></script>
}
