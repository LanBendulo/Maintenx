@model IEnumerable<IT15_Project.Models.Part>

@{
    ViewData["Title"] = "Parts Inventory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Active"] = "Parts";
}

<link rel="stylesheet" href="~/css/maintenx-workorders.css" asp-append-version="true" />

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-left">
        <h1>Parts Inventory</h1>
        <p>Manage spare parts and track inventory levels</p>
    </div>
    <div class="page-header-right">
        <button class="btn-primary-mx" id="openPartModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Part
        </button>
    </div>
</div>

<!-- SUMMARY CARDS -->
<div class="wo-stats">
    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <span class="stat-trend up">↑ @ViewBag.TotalParts</span>
        </div>
        <div class="stat-value">@ViewBag.TotalParts</div>
        <div class="stat-label">Total Parts</div>
    </div>
    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="stat-trend up">↑ @ViewBag.ActiveParts</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@ViewBag.ActiveParts</div>
        <div class="stat-label">Active</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <span class="stat-trend warn">● @ViewBag.LowStockParts</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@ViewBag.LowStockParts</div>
        <div class="stat-label">Low Stock</div>
    </div>
    <div class="stat-card gray">
        <div class="stat-top">
            <div class="stat-icon gray">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <span class="stat-trend">@ViewBag.InactiveParts</span>
        </div>
        <div class="stat-value" style="color:var(--mx-muted)">@ViewBag.InactiveParts</div>
        <div class="stat-label">Inactive</div>
    </div>
</div>

<!-- FILTER BAR -->
<div class="card" style="margin-bottom:20px;padding:18px 22px;">
    <div class="filter-bar" style="margin-bottom:0;">
        <div class="filter-search" style="max-width:350px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="part-search" placeholder="Search name, SKU, description…" value="@ViewBag.SearchFilter" />
        </div>
        <select class="filter-select" id="filter-status">
            <option value="all" selected="@(ViewBag.StatusFilter == "all" ? "selected" : null)">All Status</option>
            <option value="active" selected="@(ViewBag.StatusFilter == "active" ? "selected" : null)">Active</option>
            <option value="inactive" selected="@(ViewBag.StatusFilter == "inactive" ? "selected" : null)">Inactive</option>
        </select>
        <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;">
            <input type="checkbox" id="filter-low-stock" @(ViewBag.LowStockFilter ? "checked" : "") style="width:16px;height:16px;cursor:pointer;" />
            Low Stock Only
        </label>
        <button class="filter-reset" id="reset-filters">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
            Reset
        </button>
    </div>
</div>

<!-- PARTS TABLE -->
<div class="card">
    <div class="section-header" style="margin-bottom:8px;">
        <h2>Inventory</h2>
        <span id="row-count" class="table-meta">Showing <strong>@(Model?.Count() ?? 0)</strong> results</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="mx-table" id="parts-table">
            <thead>
                <tr>
                    <th>Part Number</th>
                    <th>Part Name</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit Cost</th>
                    <th>Reorder Level</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody id="parts-tbody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var part in Model)
                    {
                        var statusClass = part.IsActive ? "done" : "cancelled";
                        var lowStock = part.ReorderLevel.HasValue && part.Quantity <= part.ReorderLevel.Value;
                        
                        <tr data-status="@statusClass" data-low-stock="@lowStock.ToString().ToLower()">
                            <td class="td-id">@(part.PartNumber ?? "-")</td>
                            <td style="font-weight:500;">@part.PartName</td>
                            <td>
                                <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(part.Description ?? "-")
                                </div>
                            </td>
                            <td>
                                @if (lowStock)
                                {
                                    <span style="color:var(--mx-orange);font-weight:600;">@part.Quantity</span>
                                    <svg style="width:14px;height:14px;color:var(--mx-orange);vertical-align:middle;margin-left:4px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                }
                                else
                                {
                                    <span>@part.Quantity</span>
                                }
                            </td>
                            <td>@(part.UnitCost.HasValue ? part.UnitCost.Value.ToString("C") : "-")</td>
                            <td>@(part.ReorderLevel?.ToString() ?? "-")</td>
                            <td><span class="badge badge-@statusClass">@(part.IsActive ? "Active" : "Inactive")</span></td>
                            <td style="text-align:right;">
                                <div class="action-menu">
                                    <button class="action-trigger">Actions <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
                                    <div class="action-dropdown">
                                        <a href="#" class="action-view-movement-history" data-part-id="@part.PartId" data-part-name="@part.PartName">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                            Movement History
                                        </a>
                                        <a href="#" class="action-edit-part" data-part-id="@part.PartId">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            Edit
                                        </a>
                                        <a href="#" class="action-adjust-qty" data-part-id="@part.PartId" data-part-name="@part.PartName" data-current-qty="@part.Quantity">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                            Adjust Quantity
                                        </a>
                                        <a href="#" class="action-toggle-status" data-part-id="@part.PartId" data-current-status="@part.IsActive.ToString().ToLower()">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                            @(part.IsActive ? "Deactivate" : "Activate")
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align:center;padding:40px;color:var(--mx-muted);">
                            No parts in inventory. Click "Add Part" to get started.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SUCCESS TOAST -->
<div class="mx-toast-success" id="part-toast">
    <span class="toast-icon">✅</span>
    <span id="toast-message">Action completed successfully!</span>
</div>

<!-- CREATE/EDIT PART MODAL -->
<div class="mx-modal-overlay" id="partModal" role="dialog" aria-modal="true" aria-labelledby="part-modal-title">
    <div class="mx-modal">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <div>
                    <div class="modal-title" id="part-modal-title">Add Part</div>
                    <div class="modal-subtitle">Enter part details</div>
                </div>
            </div>
            <button class="modal-close" id="closePartModal" aria-label="Close">×</button>
        </div>
        <div class="modal-body">
            <form id="partForm" novalidate>
                <input type="hidden" id="partId" />

                <!-- Basic Information -->
                <div class="modal-section-label">Basic Information</div>
                <div class="modal-grid-2">
                    <div>
                        <label class="mx-label">Part Name <span class="required">*</span></label>
                        <input type="text" class="mx-input" id="partName" placeholder="e.g., Oil Filter" required />
                        <div class="input-error" id="err-part-name">Please enter a part name.</div>
                    </div>
                    <div>
                        <label class="mx-label">Part Number / SKU</label>
                        <input type="text" class="mx-input" id="partNumber" placeholder="e.g., OF-001" />
                    </div>
                </div>
                <div class="modal-full">
                    <label class="mx-label">Description</label>
                    <textarea class="mx-textarea" id="description" placeholder="Describe the part…" rows="2"></textarea>
                    <div class="input-hint">Optional — additional details about this part</div>
                </div>

                <!-- Inventory Details -->
                <div class="modal-section-label">Inventory Details</div>
                <div class="modal-grid-2">
                    <div>
                        <label class="mx-label">Quantity on Hand <span class="required">*</span></label>
                        <input type="number" class="mx-input" id="quantity" min="0" value="0" placeholder="0" required />
                        <div class="input-error" id="err-quantity">Please enter a valid quantity.</div>
                    </div>
                    <div>
                        <label class="mx-label">Unit Cost</label>
                        <input type="number" class="mx-input" id="unitCost" min="0" step="0.01" placeholder="0.00" />
                        <div class="input-hint">Cost per unit in your currency</div>
                    </div>
                </div>
                <div class="modal-grid-2">
                    <div>
                        <label class="mx-label">Reorder Level</label>
                        <input type="number" class="mx-input" id="reorderLevel" min="0" placeholder="e.g., 10" />
                        <div class="input-hint">Alert when stock falls below this level</div>
                    </div>
                    <div>
                        <label class="mx-label">Storage Location</label>
                        <input type="text" class="mx-input" id="location" placeholder="e.g., Warehouse A, Shelf 3" />
                    </div>
                </div>

            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" id="cancelPartBtn">Cancel</button>
            <button class="btn-modal-submit" id="savePartBtn">Save Part</button>
        </div>
    </div>
</div>

<!-- ADJUST QUANTITY MODAL -->
<div class="mx-modal-overlay" id="adjustQtyModal" role="dialog" aria-modal="true">
    <div class="mx-modal" style="max-width:500px;">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </div>
                <div>
                    <div class="modal-title">Adjust Quantity</div>
                    <div class="modal-subtitle" id="adjust-part-name">Part Name</div>
                </div>
            </div>
            <button class="modal-close" id="closeAdjustQtyModal">×</button>
        </div>
        <div class="modal-body">
            <form id="adjustQtyForm" novalidate>
                <input type="hidden" id="adjustPartId" />

                <!-- Current Quantity Display -->
                <div class="modal-full" style="margin-bottom:20px;">
                    <div style="background:var(--mx-bg-secondary);padding:16px;border-radius:8px;text-align:center;">
                        <div style="font-size:12px;color:var(--mx-muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;">Current Quantity</div>
                        <div style="font-size:32px;font-weight:700;color:var(--mx-primary);" id="adjust-current-qty">0</div>
                    </div>
                </div>

                <!-- Adjustment Input -->
                <div class="modal-full">
                    <label class="mx-label">Adjustment Amount <span class="required">*</span></label>
                    <input type="number" class="mx-input" id="adjustmentAmount" placeholder="Enter positive or negative number" required />
                    <div class="input-hint">Use positive numbers to add stock, negative to remove</div>
                    <div class="input-error" id="err-adjustment">Please enter a valid adjustment amount.</div>
                </div>

                <!-- Reason (Optional) -->
                <div class="modal-full" style="margin-bottom:0;">
                    <label class="mx-label">Reason (Optional)</label>
                    <input type="text" class="mx-input" id="adjustmentReason" placeholder="e.g., Received shipment, Damaged items" />
                    <div class="input-hint">Optional — reason for this adjustment</div>
                </div>

            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" id="cancelAdjustBtn">Cancel</button>
            <button class="btn-modal-submit" id="saveAdjustBtn">Adjust Quantity</button>
        </div>
    </div>
</div>

<!-- MOVEMENT HISTORY MODAL -->
<div class="mx-modal-overlay" id="movementHistoryModal" role="dialog" aria-modal="true">
    <div class="mx-modal" style="max-width:900px;">
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon" style="background:rgba(43,126,212,.10);color:var(--mx-blue);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-title">Inventory Movement History</div>
                    <div class="modal-subtitle" id="movement-history-part-name">Part Name</div>
                </div>
            </div>
            <button class="modal-close" id="closeMovementHistoryModal" aria-label="Close">×</button>
        </div>
        <div class="modal-body" style="max-height:500px;overflow-y:auto;">
            <div id="movementHistoryContainer">
                <div style="text-align:center;padding:40px;color:var(--mx-muted);">
                    Loading movement history...
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" id="closeMovementHistoryBtn">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/parts.js" asp-append-version="true"></script>
    <script src="~/js/part-movement-history.js" asp-append-version="true"></script>
}
