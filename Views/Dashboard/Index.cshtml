@model IT15_Project.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Active"] = "Dashboard";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<!-- ══════════════════════════════════════
     ROW 1 — SUMMARY CARDS
════════════════════════════════════════ -->
<div class="stats-grid">

    <div class="stat-card blue">
        <div class="stat-top">
            <div class="stat-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.TotalRequests</span>
        </div>
        <div class="stat-value">@Model.TotalRequests.ToString("N0")</div>
        <div class="stat-label">Total Maintenance Requests</div>
    </div>

    <div class="stat-card orange">
        <div class="stat-top">
            <div class="stat-icon orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <span class="stat-trend warn">▲ @Model.PendingRequests</span>
        </div>
        <div class="stat-value" style="color:var(--mx-orange)">@Model.PendingRequests</div>
        <div class="stat-label">Pending Requests</div>
    </div>

    <div class="stat-card navy">
        <div class="stat-top">
            <div class="stat-icon navy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.ActiveWorkOrders</span>
        </div>
        <div class="stat-value" style="color:var(--mx-navy)">@Model.ActiveWorkOrders</div>
        <div class="stat-label">Active Work Orders (Pending + In Progress)</div>
    </div>

    <div class="stat-card green">
        <div class="stat-top">
            <div class="stat-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                </svg>
            </div>
            <span class="stat-trend up">↑ @Model.TotalAssets</span>
        </div>
        <div class="stat-value" style="color:var(--mx-green)">@Model.TotalAssets</div>
        <div class="stat-label">Total Equipment / Assets</div>
    </div>
</div>

<!-- ══════════════════════════════════════
     ROW 2 — CHART + QUICK ACTIONS
════════════════════════════════════════ -->
<div class="mid-row">

    <!-- Status Chart -->
    <div class="card">
        <div class="section-header">
            <h2>Requests by Status</h2>
            <a href="/admin/maintenance-requests" class="view-all">View Report</a>
        </div>
        <div class="chart-wrap">
            <canvas id="statusChart"></canvas>
        </div>
        <div class="chart-legend">
            <div class="legend-item"><span class="legend-dot" style="background:#F47920"></span> Pending (@(Model.RequestStatusCounts.ContainsKey("Pending") ? Model.RequestStatusCounts["Pending"] : 0))</div>
            <div class="legend-item"><span class="legend-dot" style="background:#2B7ED4"></span> Approved (@(Model.RequestStatusCounts.ContainsKey("Approved") ? Model.RequestStatusCounts["Approved"] : 0))</div>
            <div class="legend-item"><span class="legend-dot" style="background:#22C55E"></span> Converted (@(Model.RequestStatusCounts.ContainsKey("Converted") ? Model.RequestStatusCounts["Converted"] : 0))</div>
            <div class="legend-item"><span class="legend-dot" style="background:#EF4444"></span> Rejected (@(Model.RequestStatusCounts.ContainsKey("Rejected") ? Model.RequestStatusCounts["Rejected"] : 0))</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card">
        <div class="section-header">
            <h2>Quick Actions</h2>
        </div>
        <div class="quick-grid">
            <a href="/admin/maintenance-requests" class="quick-btn qb-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                </svg>
                New Request
            </a>
            <a href="/admin/work-orders" class="quick-btn qb-navy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/>
                </svg>
                Work Order
            </a>
            <a href="/admin/assets" class="quick-btn qb-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/>
                </svg>
                Add Equipment
            </a>
            <a href="/admin/preventive-maintenance" class="quick-btn qb-orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                Schedule PM
            </a>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════
     ROW 3 — WORK ORDERS + ALERTS
════════════════════════════════════════ -->
<div class="lower-row">

    <!-- Ongoing Work Orders -->
    <div class="card">
        <div class="section-header">
            <h2>Ongoing Work Orders</h2>
            <a href="/admin/work-orders" class="view-all">View All</a>
        </div>

        @if (Model.OngoingWorkOrders.Any())
        {
            @foreach (var wo in Model.OngoingWorkOrders)
            {
                var priorityClass = wo.Priority?.ToLower() switch
                {
                    "high" => "badge-high",
                    "medium" => "badge-med",
                    "low" => "badge-low",
                    _ => "badge-med"
                };

                <div class="wo-item">
                    <span class="wo-id">#@wo.WorkOrderNumber</span>
                    <div class="wo-info">
                        <div class="wo-name">@wo.AssetName</div>
                        <div class="wo-meta">Assigned: @wo.TechnicianName &nbsp;·&nbsp; <span class="badge @priorityClass" style="padding:2px 7px;font-size:11px;">@wo.Priority</span></div>
                    </div>
                    <div class="wo-right">
                        <div class="wo-pct">@wo.ProgressPercentage%</div>
                        <div class="wo-progress">
                            <div class="wo-progress-bar"><div class="wo-progress-fill" style="width:@(wo.ProgressPercentage)%"></div></div>
                        </div>
                        <small style="font-size:11px;color:var(--mx-muted)">Due @(wo.DueDate.HasValue ? wo.DueDate.Value.ToString("MMM dd") : "N/A")</small>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="padding:40px;text-align:center;color:var(--mx-muted);">
                <p>No ongoing work orders at the moment.</p>
            </div>
        }
    </div>

    <!-- Alerts -->
    <div class="card">
        <div class="section-header">
            <h2 style="color:var(--mx-red)">⚠ Active Alerts</h2>
        </div>

        @if (Model.Alerts.Any())
        {
            @foreach (var alert in Model.Alerts)
            {
                var alertClass = alert.Severity switch
                {
                    "high" => "red",
                    "medium" => "orange",
                    "low" => "yellow",
                    _ => "yellow"
                };

                var alertIcon = alert.Severity switch
                {
                    "high" => "🔴",
                    "medium" => "🟠",
                    "low" => "🟡",
                    _ => "🟡"
                };

                <div class="alert-item @alertClass">
                    <span class="alert-icon">@alertIcon</span>
                    <div class="alert-text">
                        <div class="alert-title">@alert.Title</div>
                        <div class="alert-sub">@alert.Description</div>
                    </div>
                    <button class="alert-dismiss" title="Dismiss">×</button>
                </div>
            }
        }
        else
        {
            <div style="padding:40px;text-align:center;color:var(--mx-muted);">
                <p>✅ No active alerts. System running smoothly!</p>
            </div>
        }
    </div>
</div>

