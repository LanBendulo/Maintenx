@section Scripts {
<script>
(function () {
    // ── Donut Chart ──────────────────────────────
    var ctx = document.getElementById('statusChart').getContext('2d');
    var chartData = [47, 23, 198, 16];
    var chartTotal = chartData.reduce(function(a, b) { return a + b; }, 0);

    // Custom plugin: draws total in center of donut hole
    var centerTextPlugin = {
        id: 'centerText',
        afterDraw: function(chart) {
            var chartArea = chart.chartArea;
            var cx  = (chartArea.left + chartArea.right)  / 2;
            var cy  = (chartArea.top  + chartArea.bottom) / 2;
            var ctx2 = chart.ctx;
            ctx2.save();

            // Big number
            ctx2.font        = 'bold 34px "Plus Jakarta Sans", Inter, sans-serif';
            ctx2.fillStyle   = '#1A2B4A';
            ctx2.textAlign   = 'center';
            ctx2.textBaseline = 'middle';
            ctx2.fillText(chartTotal.toLocaleString(), cx, cy - 11);

            // Subtitle label
            ctx2.font      = '600 10.5px Inter, sans-serif';
            ctx2.fillStyle = '#6B7A99';
            ctx2.fillText('TOTAL REQUESTS', cx, cy + 14);

            ctx2.restore();
        }
    };

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'In Progress', 'Completed', 'Cancelled'],
            datasets: [{
                data: chartData,
                backgroundColor: ['#F47920', '#2B7ED4', '#22C55E', '#EF4444'],
                borderWidth: 0,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(c) {
                            var pct = Math.round(c.parsed / chartTotal * 100);
                            return ' ' + c.label + ': ' + c.parsed + ' (' + pct + '%)';
                        }
                    }
                }
            }
        },
        plugins: [centerTextPlugin]
    });

    // ── Alert dismiss ────────────────────────────
    document.querySelectorAll('.alert-dismiss').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var item = this.closest('.alert-item');
            item.style.transition = 'opacity .3s, transform .3s';
            item.style.opacity = '0';
            item.style.transform = 'translateX(10px)';
            setTimeout(function() { item.remove(); }, 300);
        });
    });
})();
</script>
}
