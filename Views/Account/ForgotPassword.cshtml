@model IT15_Project.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-split">

    <!-- ═══════════════════════════════════════
         LEFT — BRAND PANEL
    ════════════════════════════════════════ -->
    <div class="auth-brand">
        <div class="brand-gear-top"></div>

        <!-- Logo -->
        <div class="auth-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Gear -->
                <path d="M32 10 L35.5 4 L28.5 4 Z M32 54 L35.5 60 L28.5 60 Z
                         M10 32 L4 28.5 L4 35.5 Z M54 32 L60 35.5 L60 28.5 Z" fill="rgba(255,255,255,0.6)"/>
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="6" fill="none"/>
                <circle cx="32" cy="32" r="8" fill="rgba(255,255,255,0.15)"/>
                <!-- Wrench -->
                <path d="M22 42 L30 34 M36 22 C33 22 31 24 31 27 C31 28.5 31.6 29.9 32.7 31 L24 40 C23 41 23 42.5 24 43.5 C25 44.5 26.5 44.5 27.5 43.5 L36.5 34.5 C37.6 35.1 38.9 35.4 40.3 35 C43 34.2 44.5 31.5 44 28.9 L40.5 32.4 L38 32 L37.6 29.5 L41.1 26 C39 24.8 37 23.8 36 22 Z"
                      fill="white" opacity="0.9"/>
                <!-- Orange check -->
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="auth-logo-text">Mainten<span>X</span></span>
        </div>

        <!-- Hero -->
        <div class="brand-hero">
            <h1>Secure Password<br/>Recovery</h1>
            <p>Enterprise-grade account security with instant password reset capabilities.</p>

            <!-- Security features -->
            <div class="brand-stats">
                <div class="stat-chip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span class="stat-label">Encrypted</span>
                </div>
                <div class="stat-chip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <span class="stat-label">Secure</span>
                </div>
                <div class="stat-chip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <span class="stat-label">Verified</span>
                </div>
            </div>
        </div>

        <p class="brand-tagline">Your account security is our top priority.</p>
    </div>

    <!-- ═══════════════════════════════════════
         RIGHT — FORM PANEL
    ════════════════════════════════════════ -->
    <div class="auth-form-panel">
        <div class="form-panel-inner">

            <!-- Panel logo badge -->
            <div class="panel-logo-badge">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="18" stroke="#1A56A0" stroke-width="5" fill="none"/>
                    <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span class="badge-text">Mainten<span>X</span></span>
            </div>

            <!-- Heading -->
            <h2 class="form-heading">Reset Password</h2>
            <p class="form-subheading">Enter your email to receive reset instructions</p>

            <!-- Server-side validation summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mx-alert mx-alert-error" role="alert">
                    <span>⚠</span>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <!-- Info box -->
            <div class="mx-info-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="16" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <p>For security, reset instructions will be sent to the email address associated with your account.</p>
            </div>

            <form id="forgot-password-form" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="mx-field">
                    <label asp-for="Email">Email Address</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <input asp-for="Email"
                               type="email"
                               id="forgot-email"
                               autocomplete="email"
                               aria-required="true"
                               placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <!-- Submit -->
                <button id="forgot-submit" type="submit" class="btn-mx-primary">
                    <span class="btn-text">Send Reset Link</span>
                    <span class="btn-spinner" id="forgot-spinner"></span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                </button>

                <!-- Back to login -->
                <div class="form-link-row" style="margin-top:20px;">
                    <a asp-area="Identity" asp-page="/Account/Login" style="display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--mx-text-secondary); font-weight: 500;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"/>
                            <polyline points="12 19 5 12 12 5"/>
                        </svg>
                        Back to Login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Spinner on submit ────────────────────────
        document.getElementById('forgot-password-form').addEventListener('submit', function () {
            const btn     = document.getElementById('forgot-submit');
            const spinner = document.getElementById('forgot-spinner');
            const text    = btn.querySelector('.btn-text');
            text.textContent = 'Sending…';
            spinner.style.display = 'block';
            btn.disabled = true;
        });

        // ── Live validation highlight ─────────────────
        const emailInput = document.getElementById('forgot-email');
        if (emailInput) {
            emailInput.addEventListener('blur', function () {
                if (this.value.trim() === '') {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
            });
            emailInput.addEventListener('input', function () {
                if (this.value.trim() !== '') {
                    this.classList.remove('is-invalid');
                }
            });
        }
    </script>
}
