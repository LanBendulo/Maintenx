@{
    ViewData["Title"] = "Password Reset Email Sent";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-split">

    <!-- ═══════════════════════════════════════
         LEFT — BRAND PANEL
    ════════════════════════════════════════ -->
    <div class="auth-brand">
        <div class="brand-gear-top"></div>

        <!-- Logo -->
        <div class="auth-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Gear -->
                <path d="M32 10 L35.5 4 L28.5 4 Z M32 54 L35.5 60 L28.5 60 Z
                         M10 32 L4 28.5 L4 35.5 Z M54 32 L60 35.5 L60 28.5 Z" fill="rgba(255,255,255,0.6)"/>
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="6" fill="none"/>
                <circle cx="32" cy="32" r="8" fill="rgba(255,255,255,0.15)"/>
                <!-- Wrench -->
                <path d="M22 42 L30 34 M36 22 C33 22 31 24 31 27 C31 28.5 31.6 29.9 32.7 31 L24 40 C23 41 23 42.5 24 43.5 C25 44.5 26.5 44.5 27.5 43.5 L36.5 34.5 C37.6 35.1 38.9 35.4 40.3 35 C43 34.2 44.5 31.5 44 28.9 L40.5 32.4 L38 32 L37.6 29.5 L41.1 26 C39 24.8 37 23.8 36 22 Z"
                      fill="white" opacity="0.9"/>
                <!-- Orange check -->
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="auth-logo-text">Mainten<span>X</span></span>
        </div>

        <!-- Hero -->
        <div class="brand-hero">
            <h1>Reset Link<br/>Sent Successfully</h1>
            <p>Check your email for secure password reset instructions.</p>

            <!-- Security features -->
            <div class="brand-stats">
                <div class="stat-chip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    <span class="stat-label">Email Sent</span>
                </div>
                <div class="stat-chip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span class="stat-label">24hr Valid</span>
                </div>
                <div class="stat-chip">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    <span class="stat-label">Secure</span>
                </div>
            </div>
        </div>

        <p class="brand-tagline">Your account security is our top priority.</p>
    </div>

    <!-- ═══════════════════════════════════════
         RIGHT — FORM PANEL
    ════════════════════════════════════════ -->
    <div class="auth-form-panel">
        <div class="form-panel-inner">

            <!-- Success icon -->
            <div class="success-icon-large">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="30" fill="#10B981" opacity="0.1"/>
                    <circle cx="32" cy="32" r="24" fill="#10B981" opacity="0.2"/>
                    <circle cx="32" cy="32" r="18" fill="#10B981"/>
                    <path d="M20 32 L28 40 L44 24" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>

            <!-- Heading -->
            <h2 class="form-heading" style="margin-top: 24px;">Check Your Email</h2>
            <p class="form-subheading">If an account exists with that email, we've sent reset instructions</p>

            <!-- Instructions box -->
            <div class="mx-success-box">
                <div class="success-box-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <strong>What to do next:</strong>
                </div>
                <ul>
                    <li>Check your email inbox for a message from MaintenX</li>
                    <li>Click the reset link in the email (valid for 24 hours)</li>
                    <li>Create a new password for your account</li>
                    <li>Check your spam folder if you don't see the email</li>
                </ul>
            </div>

            <!-- Return to login button -->
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-mx-primary" style="text-decoration: none; display: flex;">
                <span class="btn-text">Return to Login</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </a>

            <!-- Help text -->
            <div class="form-link-row" style="margin-top:20px;">
                <p style="color: var(--mx-text-secondary); font-size: 13px; text-align: center; margin: 0;">
                    Didn't receive the email? Check your spam folder or try again in a few minutes.
                </p>
            </div>
        </div>
    </div>
</div>
