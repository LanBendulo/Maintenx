@page
@model RegisterModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Create Account";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-split">

    <!-- ═══════════════════════════════════════
         LEFT — BRAND PANEL
    ════════════════════════════════════════ -->
    <div class="auth-brand">
        <div class="brand-gear-top"></div>

        <!-- Logo -->
        <div class="auth-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="6" fill="none"/>
                <circle cx="32" cy="32" r="8" fill="rgba(255,255,255,0.15)"/>
                <path d="M22 42 L30 34 M36 22 C33 22 31 24 31 27 C31 28.5 31.6 29.9 32.7 31 L24 40 C23 41 23 42.5 24 43.5 C25 44.5 26.5 44.5 27.5 43.5 L36.5 34.5 C37.6 35.1 38.9 35.4 40.3 35 C43 34.2 44.5 31.5 44 28.9 L40.5 32.4 L38 32 L37.6 29.5 L41.1 26 C39 24.8 37 23.8 36 22 Z"
                      fill="white" opacity="0.9"/>
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="auth-logo-text">Mainten<span>X</span></span>
        </div>

        <!-- Hero -->
        <div class="brand-hero">
            <h1>Join MaintenX<br/>Today</h1>
            <p>Set up your account and start managing maintenance smarter — in minutes.</p>

            <!-- Feature list -->
            <ul class="brand-features">
                <li>
                    <span class="feat-icon">✓</span>
                    Centralized work order management
                </li>
                <li>
                    <span class="feat-icon">✓</span>
                    Real-time equipment &amp; asset tracking
                </li>
                <li>
                    <span class="feat-icon">✓</span>
                    Multi-role team collaboration
                </li>
                <li>
                    <span class="feat-icon">✓</span>
                    Scheduled maintenance &amp; calendar views
                </li>
            </ul>
        </div>

        <p class="brand-tagline">Trusted by maintenance teams across industries.</p>
    </div>

    <!-- ═══════════════════════════════════════
         RIGHT — FORM PANEL
    ════════════════════════════════════════ -->
    <div class="auth-form-panel" style="background: var(--mx-surface);">
        <div class="form-panel-inner">

            <!-- Panel logo badge -->
            <div class="panel-logo-badge">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="18" stroke="#1A56A0" stroke-width="5" fill="none"/>
                    <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span class="badge-text">Mainten<span>X</span></span>
            </div>

            <!-- Heading -->
            <h2 class="form-heading">Create Account</h2>
            <p class="form-subheading">Fill in your details to get started</p>

            <!-- Server-side error alert -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mx-alert mx-alert-error" role="alert">
                    <span>⚠</span>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()

                <!-- Company Name -->
                <div class="mx-field">
                    <label asp-for="Input.CompanyName">Company Name</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                        </span>
                        <input asp-for="Input.CompanyName"
                               type="text"
                               id="reg-company"
                               autocomplete="organization"
                               aria-required="true"
                               placeholder="Your Company Name" />
                    </div>
                    <span asp-validation-for="Input.CompanyName" class="field-error"></span>
                </div>

                <!-- Full Name -->
                <div class="mx-field">
                    <label asp-for="Input.FullName">Full Name</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                            </svg>
                        </span>
                        <input asp-for="Input.FullName"
                               type="text"
                               id="reg-fullname"
                               autocomplete="name"
                               aria-required="true"
                               placeholder="John Doe" />
                    </div>
                    <span asp-validation-for="Input.FullName" class="field-error"></span>
                </div>

                <!-- Email -->
                <div class="mx-field">
                    <label asp-for="Input.Email">Email Address</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <input asp-for="Input.Email"
                               type="email"
                               id="reg-email"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <!-- Password + Confirm — 2 column -->
                <div class="mx-field-row">

                    <!-- Password -->
                    <div class="mx-field">
                        <label asp-for="Input.Password">Password</label>
                        <div class="mx-input-wrap">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </span>
                            <input asp-for="Input.Password"
                                   type="password"
                                   id="reg-password"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Create password" />
                            <button type="button" class="btn-eye" id="toggle-reg-pwd" aria-label="Show password">
                                <svg id="eye-reg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        <!-- Strength bar -->
                        <div class="pwd-strength-wrap" id="strength-wrap" style="display:none;">
                            <div class="pwd-strength-bar">
                                <span id="s1"></span>
                                <span id="s2"></span>
                                <span id="s3"></span>
                                <span id="s4"></span>
                            </div>
                            <span class="pwd-strength-label" id="strength-label">Weak</span>
                        </div>
                        <span asp-validation-for="Input.Password" class="field-error"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mx-field">
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <div class="mx-input-wrap">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                </svg>
                            </span>
                            <input asp-for="Input.ConfirmPassword"
                                   type="password"
                                   id="reg-confirm"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Repeat password" />
                            <span class="match-icon" id="match-icon"></span>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                    </div>
                </div>

                <!-- Terms -->
                <div class="mx-terms-row">
                    <input type="checkbox" id="terms-check" />
                    <label for="terms-check">
                        I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a> of MaintenX.
                    </label>
                </div>

                <!-- Turnstile CAPTCHA Widget (only if enabled) -->
                @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
                {
                    <div class="mx-field" style="margin-top:16px;">
                        <div id="turnstile-widget" class="cf-turnstile" 
                             data-sitekey="@Configuration["Turnstile:SiteKey"]"
                             data-callback="onTurnstileSuccess"
                             data-error-callback="onTurnstileError"
                             data-theme="light"
                             data-size="normal">
                        </div>
                        <input type="hidden" asp-for="Input.TurnstileToken" id="turnstile-token" />
                        <span asp-validation-for="Input.TurnstileToken" class="field-error"></span>
                    </div>
                }

                <!-- Submit -->
                <button id="registerSubmit" type="submit" class="btn-mx-accent" disabled>
                    <span class="btn-text">Create Account</span>
                    <span class="btn-spinner" id="reg-spinner"></span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                    </svg>
                </button>

                <!-- Sign in link -->
                <div class="form-link-row">
                    Already have an account? <a asp-page="./Login">Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
    {
        <!-- Cloudflare Turnstile Script -->
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        
        <script>
            // ── Turnstile Callbacks ──────────────────────
            function onTurnstileSuccess(token) {
                console.log('Turnstile validation succeeded');
                document.getElementById('turnstile-token').value = token;
            }

            function onTurnstileError(error) {
                console.error('Turnstile error:', error);
                document.getElementById('turnstile-token').value = '';
            }
        </script>
    }
    
    <script>
        // ── Password eye toggle ──────────────────────
        document.getElementById('toggle-reg-pwd').addEventListener('click', function () {
            const input = document.getElementById('reg-password');
            const icon  = document.getElementById('eye-reg');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        });

        // ── Password strength meter ──────────────────
        const pwdInput = document.getElementById('reg-password');
        const strengthWrap  = document.getElementById('strength-wrap');
        const strengthLabel = document.getElementById('strength-label');
        const bars = [
            document.getElementById('s1'),
            document.getElementById('s2'),
            document.getElementById('s3'),
            document.getElementById('s4')
        ];

        const colors = ['#EF4444', '#F47920', '#FACC15', '#22C55E'];
        const labels = ['Weak', 'Fair', 'Good', 'Strong'];

        function calcStrength(pwd) {
            let score = 0;
            if (pwd.length >= 8)                       score++;
            if (/[A-Z]/.test(pwd))                     score++;
            if (/[0-9]/.test(pwd))                     score++;
            if (/[^A-Za-z0-9]/.test(pwd))              score++;
            return score;
        }

        pwdInput.addEventListener('input', function () {
            const val = this.value;
            if (val.length === 0) {
                strengthWrap.style.display = 'none';
                return;
            }
            strengthWrap.style.display = 'block';
            const score = calcStrength(val);
            bars.forEach(function (b, i) {
                b.style.background = i < score ? colors[score - 1] : '#E2E8F0';
            });
            strengthLabel.textContent = labels[score - 1] || 'Weak';
            strengthLabel.style.color = colors[score - 1] || '#EF4444';
            checkMatch();
        });

        // ── Confirm password live match ──────────────
        const confirmInput = document.getElementById('reg-confirm');
        const matchIcon    = document.getElementById('match-icon');

        function checkMatch() {
            const pwd  = pwdInput.value;
            const conf = confirmInput.value;
            if (conf.length === 0) {
                matchIcon.style.display = 'none';
                confirmInput.classList.remove('is-invalid');
                return;
            }
            matchIcon.style.display = 'inline';
            if (pwd === conf) {
                matchIcon.textContent = '✓';
                matchIcon.style.color = '#22C55E';
                confirmInput.classList.remove('is-invalid');
            } else {
                matchIcon.textContent = '✗';
                matchIcon.style.color = '#EF4444';
                confirmInput.classList.add('is-invalid');
            }
        }

        confirmInput.addEventListener('input', checkMatch);

        // ── Terms checkbox enables submit ────────────
        const termsCheck  = document.getElementById('terms-check');
        const submitBtn   = document.getElementById('registerSubmit');

        termsCheck.addEventListener('change', function () {
            submitBtn.disabled = !this.checked;
        });

        // ── Spinner on submit ────────────────────────
        document.getElementById('registerForm').addEventListener('submit', function (e) {
            @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
            {
                <text>
                // Validate Turnstile token before submission
                const turnstileToken = document.getElementById('turnstile-token').value;
                if (!turnstileToken || turnstileToken.trim() === '') {
                    e.preventDefault();
                    alert('Please complete the CAPTCHA verification.');
                    return false;
                }
                </text>
            }

            const spinner = document.getElementById('reg-spinner');
            const text    = submitBtn.querySelector('.btn-text');
            text.textContent = 'Creating Account…';
            spinner.style.display = 'block';
            submitBtn.disabled = true;
        });

        // ── Live validation highlight ─────────────────
        document.querySelectorAll('.mx-input-wrap input').forEach(function (input) {
            input.addEventListener('blur', function () {
                if (this.value.trim() === '') this.classList.add('is-invalid');
                else this.classList.remove('is-invalid');
            });
            input.addEventListener('input', function () {
                if (this.value.trim() !== '') this.classList.remove('is-invalid');
            });
        });
    </script>
}
