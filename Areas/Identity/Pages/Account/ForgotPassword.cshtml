@page
@model ForgotPasswordModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-split">

    <!-- ═══════════════════════════════════════
         LEFT — BRAND PANEL
    ════════════════════════════════════════ -->
    <div class="auth-brand">
        <div class="brand-gear-top"></div>

        <!-- Logo -->
        <div class="auth-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="6" fill="none"/>
                <circle cx="32" cy="32" r="8" fill="rgba(255,255,255,0.15)"/>
                <path d="M22 42 L30 34 M36 22 C33 22 31 24 31 27 C31 28.5 31.6 29.9 32.7 31 L24 40 C23 41 23 42.5 24 43.5 C25 44.5 26.5 44.5 27.5 43.5 L36.5 34.5 C37.6 35.1 38.9 35.4 40.3 35 C43 34.2 44.5 31.5 44 28.9 L40.5 32.4 L38 32 L37.6 29.5 L41.1 26 C39 24.8 37 23.8 36 22 Z"
                      fill="white" opacity="0.9"/>
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="auth-logo-text">Mainten<span>X</span></span>
        </div>

        <!-- Hero -->
        <div class="brand-hero">
            <h1>Reset Your<br/>Password</h1>
            <p>Enter your email address and we'll send you instructions to reset your password.</p>
        </div>

        <p class="brand-tagline">Secure account recovery for MaintenX users.</p>
    </div>

    <!-- ═══════════════════════════════════════
         RIGHT — FORM PANEL
    ════════════════════════════════════════ -->
    <div class="auth-form-panel">
        <div class="form-panel-inner">

            <!-- Panel logo badge -->
            <div class="panel-logo-badge">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="18" stroke="#1A56A0" stroke-width="5" fill="none"/>
                    <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span class="badge-text">Mainten<span>X</span></span>
            </div>

            <!-- Heading -->
            <h2 class="form-heading">Forgot Password</h2>
            <p class="form-subheading">Enter your email to receive reset instructions</p>

            <!-- Server-side error alert -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mx-alert mx-alert-error" role="alert">
                    <span>⚠</span>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form id="forgotPasswordForm" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="mx-field">
                    <label asp-for="Input.Email">Email Address</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <input asp-for="Input.Email"
                               type="email"
                               id="forgot-email"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <!-- Turnstile CAPTCHA Widget (only if enabled) -->
                @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
                {
                    <div class="mx-field" style="margin-top:16px;">
                        <div id="turnstile-widget" class="cf-turnstile" 
                             data-sitekey="@Configuration["Turnstile:SiteKey"]"
                             data-callback="onTurnstileSuccess"
                             data-error-callback="onTurnstileError"
                             data-theme="light"
                             data-size="normal">
                        </div>
                        <input type="hidden" asp-for="Input.TurnstileToken" id="turnstile-token" />
                        <span asp-validation-for="Input.TurnstileToken" class="field-error"></span>
                    </div>
                }

                <!-- Submit -->
                <button id="resetSubmit" type="submit" class="btn-mx-primary">
                    <span class="btn-text">Send Reset Link</span>
                    <span class="btn-spinner" id="reset-spinner"></span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </button>

                <!-- Links -->
                <div class="form-link-row" style="margin-top:18px;">
                    Remember your password? <a asp-page="./Login">Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
    {
        <!-- Cloudflare Turnstile Script -->
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        
        <script>
            // ── Turnstile Callbacks ──────────────────────
            function onTurnstileSuccess(token) {
                console.log('Turnstile validation succeeded');
                document.getElementById('turnstile-token').value = token;
            }

            function onTurnstileError(error) {
                console.error('Turnstile error:', error);
                document.getElementById('turnstile-token').value = '';
            }
        </script>
    }
    
    <script>
        // ── Spinner on submit ────────────────────────
        document.getElementById('forgotPasswordForm').addEventListener('submit', function (e) {
            @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
            {
                <text>
                // Validate Turnstile token before submission
                const turnstileToken = document.getElementById('turnstile-token').value;
                if (!turnstileToken || turnstileToken.trim() === '') {
                    e.preventDefault();
                    alert('Please complete the CAPTCHA verification.');
                    return false;
                }
                </text>
            }

            const btn     = document.getElementById('resetSubmit');
            const spinner = document.getElementById('reset-spinner');
            const text    = btn.querySelector('.btn-text');
            text.textContent = 'Sending…';
            spinner.style.display = 'block';
            btn.disabled = true;
        });

        // ── Live validation highlight ─────────────────
        document.querySelectorAll('.mx-input-wrap input').forEach(function (input) {
            input.addEventListener('blur', function () {
                if (this.value.trim() === '') {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
            });
            input.addEventListener('input', function () {
                if (this.value.trim() !== '') {
                    this.classList.remove('is-invalid');
                }
            });
        });
    </script>
}

