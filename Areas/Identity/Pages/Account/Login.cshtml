@page
@model LoginModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign In";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-split">

    <!-- ═══════════════════════════════════════
         LEFT — BRAND PANEL
    ════════════════════════════════════════ -->
    <div class="auth-brand">
        <div class="brand-gear-top"></div>

        <!-- Logo -->
        <div class="auth-logo">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Gear -->
                <path d="M32 10 L35.5 4 L28.5 4 Z M32 54 L35.5 60 L28.5 60 Z
                         M10 32 L4 28.5 L4 35.5 Z M54 32 L60 35.5 L60 28.5 Z" fill="rgba(255,255,255,0.6)"/>
                <circle cx="32" cy="32" r="18" stroke="white" stroke-width="6" fill="none"/>
                <circle cx="32" cy="32" r="8" fill="rgba(255,255,255,0.15)"/>
                <!-- Wrench -->
                <path d="M22 42 L30 34 M36 22 C33 22 31 24 31 27 C31 28.5 31.6 29.9 32.7 31 L24 40 C23 41 23 42.5 24 43.5 C25 44.5 26.5 44.5 27.5 43.5 L36.5 34.5 C37.6 35.1 38.9 35.4 40.3 35 C43 34.2 44.5 31.5 44 28.9 L40.5 32.4 L38 32 L37.6 29.5 L41.1 26 C39 24.8 37 23.8 36 22 Z"
                      fill="white" opacity="0.9"/>
                <!-- Orange check -->
                <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
            <span class="auth-logo-text">Mainten<span>X</span></span>
        </div>

        <!-- Hero -->
        <div class="brand-hero">
            <h1>Welcome Back<br/>to MaintenX</h1>
            <p>Streamline your maintenance operations with precision, speed, and complete visibility.</p>

            <!-- Stat chips -->
            <div class="brand-stats">
                <div class="stat-chip">
                    <span class="stat-num">2,450</span>
                    <span class="stat-label">Work Orders</span>
                </div>
                <div class="stat-chip">
                    <span class="stat-num">98%</span>
                    <span class="stat-label">Uptime</span>
                </div>
                <div class="stat-chip">
                    <span class="stat-num">340</span>
                    <span class="stat-label">Assets</span>
                </div>
            </div>
        </div>

        <p class="brand-tagline">Industrial-grade maintenance, elegantly managed.</p>
    </div>

    <!-- ═══════════════════════════════════════
         RIGHT — FORM PANEL
    ════════════════════════════════════════ -->
    <div class="auth-form-panel">
        <div class="form-panel-inner">

            <!-- Panel logo badge -->
            <div class="panel-logo-badge">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="18" stroke="#1A56A0" stroke-width="5" fill="none"/>
                    <path d="M20 32 L28 40 L44 22" stroke="#F47920" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span class="badge-text">Mainten<span>X</span></span>
            </div>

            <!-- Heading -->
            <h2 class="form-heading">Sign In</h2>
            <p class="form-subheading">Access your maintenance dashboard</p>

            <!-- Server-side error alert -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mx-alert mx-alert-error" role="alert">
                    <span>⚠</span>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form id="account" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="mx-field">
                    <label asp-for="Input.Email">Email Address</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <input asp-for="Input.Email"
                               type="email"
                               id="login-email"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <!-- Password -->
                <div class="mx-field">
                    <label asp-for="Input.Password">Password</label>
                    <div class="mx-input-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                        </span>
                        <input asp-for="Input.Password"
                               type="password"
                               id="login-password"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your password" />
                        <button type="button" class="btn-eye" id="toggle-pwd" aria-label="Toggle password visibility">
                            <svg id="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <!-- Remember me + Forgot -->
                <div class="mx-check-row">
                    <div class="mx-check-group">
                        <input asp-for="Input.RememberMe" type="checkbox" id="remember-me" />
                        <label for="remember-me">Remember me</label>
                    </div>
                    <a id="forgot-password" asp-controller="Account" asp-action="ForgotPassword" class="mx-forgot-link">Forgot password?</a>
                </div>

                <!-- Turnstile CAPTCHA Widget (only if enabled) -->
                @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
                {
                    <div class="mx-field" style="margin-top:16px;">
                        <div id="turnstile-widget" class="cf-turnstile" 
                             data-sitekey="@Configuration["Turnstile:SiteKey"]"
                             data-callback="onTurnstileSuccess"
                             data-error-callback="onTurnstileError"
                             data-theme="light"
                             data-size="normal">
                        </div>
                        <input type="hidden" asp-for="Input.TurnstileToken" id="turnstile-token" />
                        <span asp-validation-for="Input.TurnstileToken" class="field-error"></span>
                    </div>
                }

                <!-- Submit -->
                <button id="login-submit" type="submit" class="btn-mx-primary">
                    <span class="btn-text">Sign In</span>
                    <span class="btn-spinner" id="login-spinner"></span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </button>

                <!-- Links -->
                <div class="form-link-row" style="margin-top:18px;">
                    Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register here</a>
                </div>
                <div class="form-link-row" style="margin-top:10px;">
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="color: var(--mx-text-secondary); font-weight:400;">Resend email confirmation</a>
                </div>
            </form>

            <!-- External Login Section (OUTSIDE main form to avoid nesting) -->
            @if (Model.ExternalLogins?.Count > 0)
            {
                <div class="mx-divider">
                    <span>or continue with</span>
                </div>

                <!-- External Login Buttons -->
                <div class="external-login-buttons">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <form asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="provider" value="@provider.Name" />
                            
                            @if (provider.Name == "Google")
                            {
                                <button type="submit" class="btn-google" title="Sign in with Google">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                                    </svg>
                                    <span>Sign in with Google</span>
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn-external" title="Sign in with @provider.DisplayName">
                                    <span>Sign in with @provider.DisplayName</span>
                                </button>
                            }
                        </form>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
    {
        <!-- Cloudflare Turnstile Script -->
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        
        <script>
            // ── Turnstile Callbacks ──────────────────────
            function onTurnstileSuccess(token) {
                console.log('Turnstile validation succeeded');
                document.getElementById('turnstile-token').value = token;
            }

            function onTurnstileError(error) {
                console.error('Turnstile error:', error);
                document.getElementById('turnstile-token').value = '';
            }
        </script>
    }
    
    <script>
        // ── Eye toggle ──────────────────────────────
        document.getElementById('toggle-pwd').addEventListener('click', function () {
            const input = document.getElementById('login-password');
            const icon  = document.getElementById('eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        });

        // ── Spinner on submit ────────────────────────
        document.getElementById('account').addEventListener('submit', function (e) {
            @if (Configuration.GetValue<bool>("Turnstile:Enabled"))
            {
                <text>
                // Validate Turnstile token before submission
                const turnstileToken = document.getElementById('turnstile-token').value;
                if (!turnstileToken || turnstileToken.trim() === '') {
                    e.preventDefault();
                    alert('Please complete the CAPTCHA verification.');
                    return false;
                }
                </text>
            }

            const btn     = document.getElementById('login-submit');
            const spinner = document.getElementById('login-spinner');
            const text    = btn.querySelector('.btn-text');
            text.textContent = 'Signing in…';
            spinner.style.display = 'block';
            btn.disabled = true;
        });

        // ── Live validation highlight ─────────────────
        document.querySelectorAll('.mx-input-wrap input').forEach(function (input) {
            input.addEventListener('blur', function () {
                if (this.value.trim() === '') {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
            });
            input.addEventListener('input', function () {
                if (this.value.trim() !== '') {
                    this.classList.remove('is-invalid');
                }
            });
        });
    </script>
}
